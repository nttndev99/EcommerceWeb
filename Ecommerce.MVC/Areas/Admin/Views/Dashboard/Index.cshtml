@model Ecommerce.MVC.Areas.Admin.Models.DashboardViewModel
@using Ecommerce.Domain.Enums
@{
    ViewData["Title"] = "Dashboard";

    // Prepare chart data
    var statusLabels  = Model.StatusBreakdown.Select(s => s.Status.ToString()).ToArray();
    var statusCounts  = Model.StatusBreakdown.Select(s => s.Count).ToArray();
    var catLabels     = Model.TopCategories.Select(c => c.Name).ToArray();
    var catCounts     = Model.TopCategories.Select(c => c.ProductCount).ToArray();
}

<style>
    :root {
        --indigo: #6366f1;
        --green:  #16a34a;
        --amber:  #d97706;
        --red:    #dc2626;
        --sky:    #0284c7;
        --violet: #7c3aed;
        --card-radius: 14px;
    }

    .kpi-card {
        border-radius: var(--card-radius);
        border: 1px solid rgba(0,0,0,.06);
        background: #fff;
        box-shadow: 0 1px 3px rgba(0,0,0,.04), 0 4px 12px rgba(0,0,0,.04);
        transition: box-shadow .18s, transform .15s;
        height: 100%;
    }
    .kpi-card:hover { box-shadow: 0 6px 24px rgba(0,0,0,.09); transform: translateY(-2px); }

    .kpi-icon {
        width: 46px; height: 46px; border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.2rem; flex-shrink: 0;
    }
    .kpi-value { font-size: 1.75rem; font-weight: 800; letter-spacing: -.03em; line-height: 1; }
    .kpi-label { font-size: .68rem; font-weight: 700; text-transform: uppercase; letter-spacing: .07em; color: #9ca3af; }
    .kpi-sub   { font-size: .78rem; color: #6b7280; margin-top: .2rem; }

    .section-card {
        border-radius: var(--card-radius);
        border: 1px solid rgba(0,0,0,.06);
        background: #fff;
        box-shadow: 0 1px 3px rgba(0,0,0,.04);
        overflow: hidden;
    }
    .section-header {
        padding: 1rem 1.25rem;
        border-bottom: 1px solid #f3f4f6;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .section-label {
        font-size: .68rem; font-weight: 700;
        text-transform: uppercase; letter-spacing: .08em; color: #6b7280;
    }

    .product-thumb {
        width: 36px; height: 36px; border-radius: 8px;
        object-fit: cover; flex-shrink: 0;
    }
    .product-thumb-empty {
        width: 36px; height: 36px; border-radius: 8px;
        background: #f3f4f6; display: flex; align-items: center;
        justify-content: center; color: #d1d5db; flex-shrink: 0;
        font-size: .8rem;
    }

    .bar-track { height: 5px; border-radius: 99px; background: #f3f4f6; }
    .bar-fill  { height: 100%; border-radius: 99px; }

    .alert-row { transition: background .1s; }
    .alert-row:hover { background: #fafafa; }

    .chart-wrap { position: relative; }
</style>
<div class="container-fluid px-4 py-4">

    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h3 class="fw-bold mb-0" style="letter-spacing:-.02em">Dashboard</h3>
            <div class="text-muted small mt-1">
                <i class="bi bi-calendar3 me-1"></i>@DateTime.Now.ToString("dddd, MMMM d, yyyy")
            </div>
        </div>
        <a asp-area="Admin" asp-controller="Products" asp-action="Create"
            class="btn btn-dark btn-sm px-3 gap-2 d-flex align-items-center">
            <i class="bi bi-plus-lg"></i>New Product
        </a>
    </div>

    <div class="row g-3 mb-4">

        <div class="col-6 col-sm-4 col-md-3 col-xl-2">
            <div class="kpi-card p-3">
                <div class="kpi-icon mb-2" style="background:#eef2ff">
                    <i class="bi bi-box-seam-fill" style="color:var(--indigo)"></i>
                </div>
                <div class="kpi-label">Products</div>
                <div class="kpi-value">@Model.TotalProducts</div>
                <div class="kpi-sub">@Model.ActiveProducts active</div>
            </div>
        </div>

        <div class="col-6 col-sm-4 col-md-3 col-xl-2">
            <div class="kpi-card p-3">
                <div class="kpi-icon mb-2" style="background:#f0fdf4">
                    <i class="bi bi-grid-fill" style="color:var(--green)"></i>
                </div>
                <div class="kpi-label">Categories</div>
                <div class="kpi-value">@Model.TotalCategories</div>
                <div class="kpi-sub">taxonomy</div>
            </div>
        </div>

        <div class="col-6 col-sm-4 col-md-3 col-xl-2">
            <div class="kpi-card p-3">
                <div class="kpi-icon mb-2" style="background:#fff7ed">
                    <i class="bi bi-layers-fill" style="color:var(--amber)"></i>
                </div>
                <div class="kpi-label">Variants</div>
                <div class="kpi-value">@Model.TotalVariants</div>
                <div class="kpi-sub">@Model.TotalImages images</div>
            </div>
        </div>

        <div class="col-6 col-sm-4 col-md-3 col-xl-2">
            <div class="kpi-card p-3" style="border-color:#fef3c7">
                <div class="kpi-icon mb-2" style="background:#fffbeb">
                    <i class="bi bi-exclamation-triangle-fill" style="color:var(--amber)"></i>
                </div>
                <div class="kpi-label">Low Stock</div>
                <div class="kpi-value text-warning">@Model.LowStockCount</div>
                <div class="kpi-sub">needs restock</div>
            </div>
        </div>

        <div class="col-6 col-sm-4 col-md-3 col-xl-2">
            <div class="kpi-card p-3" style="border-color:#fee2e2">
                <div class="kpi-icon mb-2" style="background:#fef2f2">
                    <i class="bi bi-x-circle-fill" style="color:var(--red)"></i>
                </div>
                <div class="kpi-label">Out of Stock</div>
                <div class="kpi-value text-danger">@Model.OutOfStockCount</div>
                <div class="kpi-sub">unavailable</div>
            </div>
        </div>

        <div class="col-6 col-sm-4 col-md-3 col-xl-2">
            <div class="kpi-card p-3">
                <div class="kpi-icon mb-2" style="background:#f5f3ff">
                    <i class="bi bi-bag-fill" style="color:var(--violet)"></i>
                </div>
                <div class="kpi-label">Total Alerts</div>
                <div class="kpi-value">@(Model.LowStockCount + Model.OutOfStockCount)</div>
                <div class="kpi-sub">stock warnings</div>
            </div>
        </div>

    </div>

    <div class="row g-4 mb-4">

        <div class="col-md-4">
            <div class="section-card h-100">
                <div class="section-header">
                    <span class="section-label">Products by Status</span>
                </div>
                <div class="p-4">
                    <div class="chart-wrap" style="height:200px">
                        <canvas id="statusChart"></canvas>
                    </div>
                    <div class="mt-3 d-flex flex-column gap-2">
                        @{
                            var statusColors = new[] { "#6366f1","#16a34a","#d97706","#6b7280" };
                            int sci = 0;
                        }
                        @foreach (var s in Model.StatusBreakdown)
                        {
                            var col = statusColors[sci++ % statusColors.Length];
                            double pct = Model.TotalProducts > 0 ? (double)s.Count / Model.TotalProducts * 100 : 0;
                            <div class="d-flex align-items-center justify-content-between small">
                                <div class="d-flex align-items-center gap-2">
                                    <span style="width:10px;height:10px;border-radius:3px;background:@col;flex-shrink:0;display:inline-block"></span>
                                    <span>@s.Status</span>
                                </div>
                                <span class="fw-semibold">@s.Count <span class="text-muted fw-normal">(@pct.ToString("F0")%)</span></span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="section-card h-100">
                <div class="section-header">
                    <span class="section-label">Top Categories by Products</span>
                </div>
                <div class="p-4">
                    <div class="chart-wrap" style="height:240px">
                        <canvas id="catChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <div class="row g-4">

        <div class="col-xl-8">
            <div class="section-card">
                <div class="section-header">
                    <span class="section-label">Recent Products</span>
                    <a asp-area="Admin" asp-controller="Products" asp-action="Index"
                    class="btn btn-outline-secondary btn-sm">View all</a>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 small">
                        <thead style="background:#fafafa">
                            <tr>
                                <th class="ps-4 py-3 border-0 text-muted fw-semibold text-uppercase" style="font-size:.67rem;letter-spacing:.06em">Product</th>
                                <th class="py-3 border-0 text-muted fw-semibold text-uppercase" style="font-size:.67rem;letter-spacing:.06em">Category</th>
                                <th class="py-3 border-0 text-muted fw-semibold text-uppercase text-end" style="font-size:.67rem;letter-spacing:.06em">Price</th>
                                <th class="py-3 border-0 text-muted fw-semibold text-uppercase" style="font-size:.67rem;letter-spacing:.06em">Status</th>
                                <th class="pe-4 py-3 border-0 text-muted fw-semibold text-uppercase text-end" style="font-size:.67rem;letter-spacing:.06em">Stock</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.RecentProducts)
                            {
                                <tr>
                                    <td class="ps-4 py-3">
                                        <div class="d-flex align-items-center gap-2">
                                            @if (!string.IsNullOrEmpty(p.PrimaryImage))
                                            {
                                                <img src="@p.PrimaryImage" class="product-thumb border" />
                                            }
                                            else
                                            {
                                                <div class="product-thumb-empty border">
                                                    <i class="bi bi-image"></i>
                                                </div>
                                            }
                                            <div style="min-width:0">
                                                <a asp-area="Admin" asp-controller="Products"
                                                asp-action="Detail" asp-route-id="@p.Id"
                                                class="fw-semibold text-dark text-decoration-none d-block text-truncate"
                                                style="max-width:170px">@p.Name</a>
                                                @if (!string.IsNullOrEmpty(p.Brand))
                                                {
                                                    <div class="text-muted" style="font-size:.73rem">@p.Brand</div>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-muted">@p.CategoryName</td>
                                    <td class="text-end">
                                        @if (p.SalePrice.HasValue)
                                        {
                                            <div class="fw-bold text-danger" style="font-size:.85rem">@p.SalePrice.Value.ToString("N0") ₫</div>
                                            <div class="text-muted text-decoration-line-through" style="font-size:.73rem">@p.BasePrice.ToString("N0") ₫</div>
                                        }
                                        else
                                        {
                                            <div class="fw-semibold" style="font-size:.85rem">@p.BasePrice.ToString("N0") ₫</div>
                                        }
                                    </td>
                                    <td>
                                        @{
                                            var badge = p.Status switch
                                            {
                                                ProductStatus.Active   => "bg-success",
                                                ProductStatus.Draft    => "bg-secondary",
                                                ProductStatus.OutOfStock => "bg-warning text-dark",
                                                _                      => "bg-light text-dark border"
                                            };
                                        }
                                        <span class="badge @badge rounded-pill">@p.Status</span>
                                        @if (p.IsFeatured)
                                        {
                                            <span class="badge bg-warning text-dark rounded-pill ms-1">★</span>
                                        }
                                    </td>
                                    <td class="pe-4 text-end fw-semibold @(p.TotalStock == 0 ? "text-danger" : p.TotalStock <= 10 ? "text-warning" : "")">
                                        @p.TotalStock
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-xl-4 d-flex flex-column gap-4">

            <div class="section-card">
                <div class="section-header">
                    <span class="section-label">Stock Alerts</span>
                    <span class="badge bg-danger rounded-pill">@(Model.LowStockCount + Model.OutOfStockCount)</span>
                </div>

                @if (!Model.StockAlerts.Any())
                {
                    <div class="text-center py-4 text-muted small">
                        <i class="bi bi-check-circle-fill text-success d-block mb-1" style="font-size:1.5rem"></i>
                        All items in stock
                    </div>
                }
                else
                {
                    <ul class="list-unstyled mb-0">
                        @foreach (var a in Model.StockAlerts)
                        {
                            <li class="alert-row d-flex align-items-center justify-content-between px-4 py-3 border-bottom">
                                <div style="min-width:0" class="me-2">
                                    <a asp-area="Admin" asp-controller="Inventories"
                                    asp-action="Detail" asp-route-id="@a.ProductId"
                                    class="fw-semibold text-dark text-decoration-none d-block text-truncate small"
                                    style="max-width:150px">@a.ProductName</a>
                                    @if (!string.IsNullOrEmpty(a.VariantName))
                                    {
                                        <div class="text-muted" style="font-size:.72rem">@a.VariantName</div>
                                    }
                                </div>
                                <div class="d-flex align-items-center gap-1 flex-shrink-0">
                                    @if (a.IsOutOfStock)
                                    {
                                        <span class="badge bg-danger rounded-pill">Out</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark rounded-pill">@a.Available</span>
                                    }
                                    <a asp-area="Admin" asp-controller="Inventories"
                                    asp-action="Adjust" asp-route-id="@a.InvId"
                                    class="btn btn-light btn-sm py-0 px-2" title="Adjust stock">
                                        <i class="bi bi-sliders" style="font-size:.75rem"></i>
                                    </a>
                                </div>
                            </li>
                        }
                    </ul>
                    <div class="text-center py-2">
                        <a asp-area="Admin" asp-controller="Inventories" asp-action="LowStock"
                        class="small text-muted text-decoration-none">View all alerts →</a>
                    </div>
                }
            </div>

            <div class="section-card p-4">
                <div class="section-label mb-3">Quick Actions</div>
                <div class="d-grid gap-2">
                    <a asp-area="Admin" asp-controller="Products"     asp-action="Create"
                    class="btn btn-outline-secondary btn-sm text-start d-flex align-items-center gap-2">
                        <i class="bi bi-plus-circle" style="color:var(--indigo)"></i>Add Product
                    </a>
                    <a asp-area="Admin" asp-controller="Inventories"  asp-action="Index"
                    class="btn btn-outline-secondary btn-sm text-start d-flex align-items-center gap-2">
                        <i class="bi bi-boxes" style="color:var(--green)"></i>Manage Inventory
                    </a>
                    <a asp-area="Admin" asp-controller="Orders"       asp-action="Index"
                    class="btn btn-outline-secondary btn-sm text-start d-flex align-items-center gap-2">
                        <i class="bi bi-bag" style="color:var(--violet)"></i>View Orders
                    </a>
                    <a asp-area="Admin" asp-controller="Customers"    asp-action="Index"
                    class="btn btn-outline-secondary btn-sm text-start d-flex align-items-center gap-2">
                        <i class="bi bi-people" style="color:var(--sky)"></i>Customers
                    </a>
                    <a asp-area="Admin" asp-controller="UsersManager" asp-action="Create"
                    class="btn btn-outline-secondary btn-sm text-start d-flex align-items-center gap-2">
                        <i class="bi bi-person-plus" style="color:var(--amber)"></i>New User
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
<script>
    Chart.defaults.font.family = "inherit";
    Chart.defaults.color       = "#6b7280";

    // ── Donut: Status ──────────────────────────────────────────
    new Chart(document.getElementById("statusChart"), {
        type: "doughnut",
        data: {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(statusLabels)),
            datasets: [{
                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(statusCounts)),
                backgroundColor: ["#6366f1","#16a34a","#d97706","#6b7280"],
                borderWidth: 2,
                borderColor: "#fff",
                hoverOffset: 6,
            }]
        },
        options: {
            cutout: "68%",
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false },
                tooltip: {
                    callbacks: {
                        label: ctx => ` ${ctx.label}: ${ctx.parsed}`
                    }
                }
            }
        }
    });

    // ── Bar: Top Categories ────────────────────────────────────
    new Chart(document.getElementById("catChart"), {
        type: "bar",
        data: {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(catLabels)),
            datasets: [{
                label: "Products",
                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(catCounts)),
                backgroundColor: "rgba(99,102,241,.15)",
                borderColor:     "#6366f1",
                borderWidth: 2,
                borderRadius: 6,
                borderSkipped: false,
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false },
                tooltip: {
                    callbacks: {
                        label: ctx => ` ${ctx.parsed.y} products`
                    }
                }
            },
            scales: {
                x: {
                    grid: { display: false },
                    ticks: { font: { size: 11 } }
                },
                y: {
                    grid: { color: "#f3f4f6" },
                    ticks: {
                        precision: 0,
                        font: { size: 11 }
                    },
                    beginAtZero: true
                }
            }
        }
    });
</script>
}

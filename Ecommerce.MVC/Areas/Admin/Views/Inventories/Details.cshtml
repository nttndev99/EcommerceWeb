@using Ecommerce.Application.DTOs.Inventory
@model InventoryDto
@{
    ViewData["Title"] = "Inventory Detail";
}

<div class="container-fluid px-4 py-4">

    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h4 class="fw-semibold mb-0">Inventory Detail</h4>
            <small class="text-muted">Stock record #@Model.Id</small>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back
            </a>
            <a asp-action="Update" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-pencil me-1"></i> Edit
            </a>
            <a asp-action="Adjust" asp-route-id="@Model.Id" class="btn btn-dark btn-sm">
                <i class="bi bi-arrow-left-right me-1"></i> Adjust Stock
            </a>
        </div>
    </div>

    <div class="row g-4">

        <div class="col-12">
            <div class="row g-3">
                <div class="col-sm-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body">
                            <div class="text-muted small mb-1">Total Quantity</div>
                            <div class="fs-3 fw-bold">@Model.Quantity</div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body">
                            <div class="text-muted small mb-1">Reserved</div>
                            <div class="fs-3 fw-bold text-secondary">@Model.ReservedQuantity</div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body">
                            <div class="text-muted small mb-1">Available</div>
                            <div class="fs-3 fw-bold @(Model.IsOutOfStock ? "text-danger" : Model.IsLowStock ? "text-warning" : "text-success")">
                                @Model.AvailableQuantity
                            </div>
                            <div class="mt-1">
                                @if (Model.IsOutOfStock)
                                {
                                    <span class="badge bg-danger">Out of stock</span>
                                }
                                else if (Model.IsLowStock)
                                {
                                    <span class="badge bg-warning text-dark">Low stock</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">In stock</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-bottom py-3">
                    <h6 class="mb-0 fw-semibold">Product Info</h6>
                </div>
                <div class="card-body">
                    <dl class="row mb-0 small">
                        <dt class="col-5 text-muted fw-normal">Product</dt>
                        <dd class="col-7 fw-semibold">@Model.ProductName</dd>

                        <dt class="col-5 text-muted fw-normal">Variant</dt>
                        <dd class="col-7">@(Model.VariantName ?? "—")</dd>

                        <dt class="col-5 text-muted fw-normal">Warehouse Location</dt>
                        <dd class="col-7">@(Model.WarehouseLocation ?? "—")</dd>

                        <dt class="col-5 text-muted fw-normal">Low Stock Threshold</dt>
                        <dd class="col-7">@Model.LowStockThreshold</dd>

                        <dt class="col-5 text-muted fw-normal">Last Updated</dt>
                        <dd class="col-7">@Model.LastStockUpdate.ToString("dd MMM yyyy, HH:mm")</dd>
                    </dl>
                </div>
            </div>
        </div>

    </div>
</div>

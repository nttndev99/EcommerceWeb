@model Ecommerce.Application.DTOs.Auth.LoginDto
@{ ViewData["Title"] = "Sign In"; Layout = "_AuthLayout"; }

<div class="auth-card">
    <div class="auth-header">
        <div class="auth-logo">
            <i class="bi bi-bag-fill"></i>
        </div>
        <h1 class="auth-title">Welcome back</h1>
        <p class="auth-subtitle">Sign in to your account</p>
    </div>

    <form asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post" class="auth-form">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="auth-error"></div>

        <div class="form-group">
            <label asp-for="Email" class="form-label">Email address</label>
            <div class="input-wrapper">
                <i class="bi bi-envelope input-icon"></i>
                <input asp-for="Email" type="email" class="form-control auth-input"
                    placeholder="you@example.com" autocomplete="email" />
            </div>
            <span asp-validation-for="Email" class="field-error"></span>
        </div>

        <div class="form-group">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <label asp-for="Password" class="form-label mb-0">Password</label>
                <a asp-action="ForgotPassword" class="auth-link-small">Forgot password?</a>
            </div>
            <div class="input-wrapper">
                <i class="bi bi-lock input-icon"></i>
                <input asp-for="Password" type="password" class="form-control auth-input"
                    placeholder="••••••••" autocomplete="current-password" id="passwordInput" />
                <button type="button" class="input-toggle" onclick="togglePassword('passwordInput', this)">
                    <i class="bi bi-eye"></i>
                </button>
            </div>
            <span asp-validation-for="Password" class="field-error"></span>
        </div>

        <div class="form-check mb-3">
            <input asp-for="RememberMe" class="form-check-input" type="checkbox" id="rememberMe" />
            <label class="form-check-label small text-muted" for="rememberMe">Keep me signed in</label>
        </div>

        <button type="submit" class="btn-auth">Sign In</button>
    </form>

    <div class="auth-footer">
        Don't have an account?
        <a asp-action="Register" asp-route-returnUrl="@ViewBag.ReturnUrl" class="auth-link">Create one</a>
    </div>
</div>

@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }

@model Ecommerce.Application.DTOs.Auth.ForgotPasswordDto
@{ ViewData["Title"] = "Forgot Password"; Layout = "_AuthLayout"; }

<div class="auth-card">
    <div class="auth-header">
        <div class="auth-logo auth-logo--warning">
            <i class="bi bi-key-fill"></i>
        </div>
        <h1 class="auth-title">Forgot password?</h1>
        <p class="auth-subtitle">Enter your email and we'll send you a reset link</p>
    </div>

    <form asp-action="ForgotPassword" method="post" class="auth-form">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="auth-error"></div>

        <div class="form-group">
            <label asp-for="Email" class="form-label">Email address</label>
            <div class="input-wrapper">
                <i class="bi bi-envelope input-icon"></i>
                <input asp-for="Email" type="email" class="form-control auth-input"
                       placeholder="you@example.com" autocomplete="email" />
            </div>
            <span asp-validation-for="Email" class="field-error"></span>
        </div>

        <button type="submit" class="btn-auth">Send Reset Link</button>
    </form>

    <div class="auth-footer">
        Remember your password?
        <a asp-action="Login" class="auth-link">Sign in</a>
    </div>
</div>

@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }

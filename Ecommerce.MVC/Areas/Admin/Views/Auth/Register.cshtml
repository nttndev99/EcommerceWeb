@model Ecommerce.Application.DTOs.Auth.RegisterDto
@{ ViewData["Title"] = "Create Account"; Layout = "_AuthLayout"; }

<div class="auth-card">
    <div class="auth-header">
        <div class="auth-logo">
            <i class="bi bi-bag-fill"></i>
        </div>
        <h1 class="auth-title">Create account</h1>
        <p class="auth-subtitle">Join us today — it's free</p>
    </div>

    <form asp-action="Register" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post" class="auth-form">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="auth-error"></div>

        <div class="form-group">
            <label asp-for="FullName" class="form-label">Full name</label>
            <div class="input-wrapper">
                <i class="bi bi-person input-icon"></i>
                <input asp-for="FullName" type="text" class="form-control auth-input"
                    placeholder="John Doe" autocomplete="name" />
            </div>
            <span asp-validation-for="FullName" class="field-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Email" class="form-label">Email address</label>
            <div class="input-wrapper">
                <i class="bi bi-envelope input-icon"></i>
                <input asp-for="Email" type="email" class="form-control auth-input"
                    placeholder="you@example.com" autocomplete="email" />
            </div>
            <span asp-validation-for="Email" class="field-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="PhoneNumber" class="form-label">Phone number</label>
            <div class="input-wrapper">
                <i class="bi bi-telephone input-icon"></i>
                <input asp-for="PhoneNumber" type="tel" class="form-control auth-input"
                    placeholder="0901 234 567" autocomplete="tel" />
            </div>
            <span asp-validation-for="PhoneNumber" class="field-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Password" class="form-label">Password</label>
            <div class="input-wrapper">
                <i class="bi bi-lock input-icon"></i>
                <input asp-for="Password" type="password" class="form-control auth-input"
                    placeholder="Min. 6 characters" autocomplete="new-password" id="passwordInput" />
                <button type="button" class="input-toggle" onclick="togglePassword('passwordInput', this)">
                    <i class="bi bi-eye"></i>
                </button>
            </div>
            <span asp-validation-for="Password" class="field-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="ConfirmPassword" class="form-label">Confirm password</label>
            <div class="input-wrapper">
                <i class="bi bi-lock-fill input-icon"></i>
                <input asp-for="ConfirmPassword" type="password" class="form-control auth-input"
                    placeholder="Repeat password" autocomplete="new-password" id="confirmInput" />
                <button type="button" class="input-toggle" onclick="togglePassword('confirmInput', this)">
                    <i class="bi bi-eye"></i>
                </button>
            </div>
            <span asp-validation-for="ConfirmPassword" class="field-error"></span>
        </div>

        <button type="submit" class="btn-auth">Create Account</button>
    </form>

    <div class="auth-footer">
        Already have an account?
        <a asp-action="Login" class="auth-link">Sign in</a>
    </div>
</div>

@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }

@{
    ViewData["Title"] = "Resend Confirmation";
    Layout = "_AuthLayout";
}

<div class="auth-card">

    @if (ViewBag.Success == true)
    {
        <div class="auth-header">
            <div class="auth-logo auth-logo--success">
                <i class="bi bi-envelope-check-fill"></i>
            </div>

            <h1 class="auth-title">Email Sent</h1>

            <p class="auth-subtitle">
                A new confirmation email has been sent. Please check your inbox.
            </p>

        </div>

        <a asp-action="Login" class="btn-auth d-block text-center text-decoration-none">
            Sign In
        </a>
    }
    else
    {

        <div class="auth-header">
            <h1 class="auth-title">Resend Confirmation</h1>
            <p class="auth-subtitle">
                Enter your email to receive a new confirmation link
            </p>
        </div>

        <form method="post">

            <div class="form-group mb-3">

                <input type="email" name="email" class="form-control" placeholder="Enter your email" required />

            </div>

            <button type="submit" class="btn-auth w-100">
                Send Confirmation Email
            </button>

        </form>

    }

    <div class="auth-footer">
        <a asp-action="Login" class="auth-link">
            Back to Sign In
        </a>
    </div>

</div>
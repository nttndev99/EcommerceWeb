@{ ViewData["Title"] = "Email Confirmation"; Layout = "_AuthLayout"; }

<div class="auth-card">
    @if (ViewBag.Success == true)
    {
        <div class="auth-header">
            <div class="auth-logo auth-logo--success">
                <i class="bi bi-check-circle-fill"></i>
            </div>
            <h1 class="auth-title">Email confirmed!</h1>
            <p class="auth-subtitle">Your email has been verified. You can now sign in.</p>
        </div>
        <a asp-action="Login" class="btn-auth d-block text-center text-decoration-none">
            Sign In
        </a>
    }
    else
    {
        <div class="auth-header">
            <div class="auth-logo auth-logo--danger">
                <i class="bi bi-x-circle-fill"></i>
            </div>
            <h1 class="auth-title">Confirmation failed</h1>
            <p class="auth-subtitle">@ViewBag.Error</p>
        </div>
        <a asp-action="ResendConfirmation" class="btn-auth d-block text-center text-decoration-none">
            Resend Confirmation Email
        </a>
    }

    <div class="auth-footer">
        <a asp-action="Login" class="auth-link">Back to Sign In</a>
    </div>
</div>

@{ ViewData["Title"] = "Check Your Email"; Layout = "_AuthLayout"; }

<div class="auth-card">
    <div class="auth-header">
        <div class="auth-logo auth-logo--warning">
            <i class="bi bi-envelope-open-fill"></i>
        </div>
        <h1 class="auth-title">Check your email</h1>
        <p class="auth-subtitle">
            We sent a confirmation link to<br>
            <strong>@ViewBag.Email</strong>
        </p>
    </div>

    <div class="alert alert-light border text-center small py-3 mb-3">
        <i class="bi bi-info-circle me-1 text-primary"></i>
        Click the link in the email to activate your account.<br>
        The link expires in <strong>24 hours</strong>.
    </div>

    <div class="d-flex flex-column gap-2">
        <a asp-action="Login"
           class="btn-auth d-block text-center text-decoration-none">
            <i class="bi bi-box-arrow-in-right me-2"></i>Back to Sign In
        </a>
        <a asp-action="ResendConfirmation"
           class="btn btn-outline-secondary btn-sm text-center">
            <i class="bi bi-arrow-clockwise me-1"></i>Resend confirmation email
        </a>
    </div>

    <div class="auth-footer">
        <span class="text-muted small">Didn't receive the email? Check your spam folder.</span>
    </div>
</div>

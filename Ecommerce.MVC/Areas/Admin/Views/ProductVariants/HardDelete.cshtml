@model Ecommerce.Application.DTOs.Product.ProductVariantDto

@{
    ViewData["Title"] = "Delete Variant Permanently";
    string productName = ViewBag.ProductName ?? "Product";
    int    productId   = ViewBag.ProductId   ?? 0;
}

<div class="container-xxl py-4">

    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small mb-0">
            <li class="breadcrumb-item">
                <a asp-controller="Products" asp-action="Index" class="text-decoration-none text-muted">Products</a>
            </li>
            <li class="breadcrumb-item">
                <a asp-controller="Products" asp-action="Detail" asp-route-id="@productId"
                class="text-decoration-none text-muted">@productName</a>
            </li>
            <li class="breadcrumb-item">
                <a asp-action="Index" asp-route-productId="@productId"
                class="text-decoration-none text-muted">Variants</a>
            </li>
            <li class="breadcrumb-item active fw-semibold text-danger">Delete Permanently</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">

            <div class="alert alert-danger d-flex align-items-start gap-3 mb-4" role="alert">
                <i class="bi bi-exclamation-octagon-fill flex-shrink-0 mt-1 fs-5"></i>
                <div>
                    <div class="fw-semibold">Permanent Deletion — This Cannot Be Undone</div>
                    <div class="small mt-1">
                        All data associated with this variant including stock records will be
                        <strong>permanently deleted</strong>. This action is irreversible.
                    </div>
                </div>
            </div>

            <div class="card border border-danger border-opacity-25 mb-4">
                <div class="card-header bg-transparent border-bottom border-danger border-opacity-25 py-3 px-4">
                    <span class="text-danger fw-bold text-uppercase small">
                        <i class="bi bi-trash3-fill me-1"></i>Variant to Delete
                    </span>
                </div>
                <div class="card-body px-4 py-4">

                    <div class="d-flex align-items-start gap-3 mb-3">
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <img src="@Model.ImageUrl" alt="@Model.Name"
                                class="rounded-3 border object-fit-cover flex-shrink-0 opacity-75"
                                width="64" height="64"
                                onerror="this.style.display='none'" />
                        }
                        else
                        {
                            <div class="rounded-3 border bg-danger bg-opacity-10 d-flex align-items-center justify-content-center flex-shrink-0"
                                style="width:64px;height:64px">
                                <i class="bi bi-image text-danger fs-4"></i>
                            </div>
                        }
                        <div>
                            <div class="fw-bold fs-6 text-danger">@Model.Name</div>
                            @if (!string.IsNullOrEmpty(Model.SKU))
                            {
                                <code class="small text-muted">@Model.SKU</code>
                            }
                            <div class="d-flex flex-wrap gap-1 mt-2">
                                @if (!string.IsNullOrEmpty(Model.Color))
                                {
                                    <span class="badge rounded-pill bg-light text-dark border d-inline-flex align-items-center gap-1 fw-normal small">
                                        <span class="rounded-circle border"
                                            style="width:10px;height:10px;background:@Model.Color;display:inline-block"></span>
                                        @Model.Color
                                    </span>
                                }
                                @if (!string.IsNullOrEmpty(Model.Size))
                                {
                                    <span class="badge rounded-pill bg-light text-dark border fw-normal small">@Model.Size</span>
                                }
                                @if (!string.IsNullOrEmpty(Model.Material))
                                {
                                    <span class="badge rounded-pill bg-light text-dark border fw-normal small">@Model.Material</span>
                                }
                            </div>
                        </div>
                    </div>

                    <hr />

                    <div class="row g-2 small">
                        <div class="col-6">
                            <div class="d-flex justify-content-between align-items-center py-1 border-bottom">
                                <span class="text-muted">ID</span>
                                <code>#@Model.Id</code>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="d-flex justify-content-between align-items-center py-1 border-bottom">
                                <span class="text-muted">Price</span>
                                <span class="fw-semibold font-monospace">@Model.Price.ToString("N0") ₫</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="d-flex justify-content-between align-items-center py-1 border-bottom">
                                <span class="text-muted">Stock</span>
                                <span class="fw-semibold @(Model.Stock == 0 ? "text-danger" : "text-dark")">@Model.Stock</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="d-flex justify-content-between align-items-center py-1 border-bottom">
                                <span class="text-muted">Display Order</span>
                                <span class="fw-semibold">@Model.DisplayOrder</span>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3 p-3 rounded-3 bg-danger bg-opacity-10 border border-danger border-opacity-25">
                        <div class="small fw-semibold text-danger mb-2">
                            <i class="bi bi-list-check me-1"></i>What will be deleted:
                        </div>
                        <ul class="small text-danger mb-0 ps-3">
                            <li>Variant record and all its data</li>
                            <li>All inventory entries for this variant</li>
                            <li>Associated stock adjustment history</li>
                        </ul>
                    </div>

                </div>
            </div>

            <div class="card border border-danger border-opacity-25 mb-4">
                <div class="card-body px-4 py-3">
                    <label for="confirmInput" class="form-label fw-semibold small">
                        Type <strong class="text-danger">@Model.Name</strong> to confirm deletion:
                    </label>
                    <input type="text"
                        id="confirmInput"
                        class="form-control"
                        placeholder="@Model.Name"
                        autocomplete="off" />
                    <div class="form-text text-danger d-none" id="confirmError">
                        <i class="bi bi-x-circle me-1"></i>Name does not match.
                    </div>
                </div>
            </div>

            <form asp-action="HardDelete" 
                asp-route-variantId="@Model.Id"
                asp-route-productId="@((int)(ViewBag.ProductId ?? 0))"
                method="post" id="deleteForm">
                @Html.AntiForgeryToken()
                <div class="d-flex gap-2">
                    <button type="submit" id="deleteBtn"
                            class="btn btn-danger d-flex align-items-center gap-2 flex-grow-1 justify-content-center"
                            disabled>
                        <i class="bi bi-trash3-fill"></i>Delete Permanently
                    </button>
                    <a asp-area="Admin" asp-controller="ProductVariants"
                    asp-action="Trash"
                    asp-route-id="@((int)(ViewBag.ProductId ?? 0))"
                    class="btn btn-outline-secondary d-flex align-items-center gap-2 flex-grow-1 justify-content-center">
                        <i class="bi bi-x-circle"></i>Cancel
                    </a>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        const confirmInput = document.getElementById('confirmInput');
        const deleteBtn    = document.getElementById('deleteBtn');
        const confirmError = document.getElementById('confirmError');
        const expected     = '@Html.Raw(Model.Name.Replace("'", "\\'"))';

        confirmInput?.addEventListener('input', () => {
            const match = confirmInput.value === expected;
            deleteBtn.disabled = !match;
            if (confirmInput.value.length > 0 && !match) {
                confirmError.classList.remove('d-none');
                confirmInput.classList.add('is-invalid');
            } else {
                confirmError.classList.add('d-none');
                confirmInput.classList.remove('is-invalid');
            }
        });
    </script>
}

@model Ecommerce.Application.DTOs.Product.ProductVariantDto

@{
    ViewData["Title"] = "Move Variant to Trash";
    string productName = ViewBag.ProductName ?? "Product";
    int    productId   = ViewBag.ProductId   ?? 0;
}

<div class="container-xxl py-4">

    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small mb-0">
            <li class="breadcrumb-item">
                <a asp-controller="Products" asp-action="Index" class="text-decoration-none text-muted">Products</a>
            </li>
            <li class="breadcrumb-item">
                <a asp-controller="Products" asp-action="Detail" asp-route-id="@productId"
                class="text-decoration-none text-muted">@productName</a>
            </li>
            <li class="breadcrumb-item">
                <a asp-action="Index" asp-route-productId="@productId"
                class="text-decoration-none text-muted">Variants</a>
            </li>
            <li class="breadcrumb-item active fw-semibold">Move to Trash</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">

            <div class="alert alert-warning d-flex align-items-start gap-3 mb-4" role="alert">
                <i class="bi bi-archive-fill flex-shrink-0 mt-1 fs-5"></i>
                <div>
                    <div class="fw-semibold">Move to Trash</div>
                    <div class="small">This variant will be deactivated and hidden from the storefront. You can restore it later.</div>
                </div>
            </div>

            <div class="card border mb-4">
                <div class="card-header bg-transparent border-bottom py-3 px-4">
                    <span class="text-muted fw-bold text-uppercase small">
                        <i class="bi bi-grid me-1"></i>Variant to Archive
                    </span>
                </div>
                <div class="card-body px-4 py-4">

                    <div class="d-flex align-items-start gap-3 mb-3">
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <img src="@Model.ImageUrl" alt="@Model.Name"
                                class="rounded-3 border object-fit-cover flex-shrink-0"
                                width="64" height="64"
                                onerror="this.style.display='none'" />
                        }
                        else
                        {
                            <div class="rounded-3 border bg-light d-flex align-items-center justify-content-center flex-shrink-0"
                                style="width:64px;height:64px">
                                <i class="bi bi-image text-secondary fs-4"></i>
                            </div>
                        }
                        <div>
                            <div class="fw-bold fs-6">@Model.Name</div>
                            @if (!string.IsNullOrEmpty(Model.SKU))
                            {
                                <code class="small text-muted">@Model.SKU</code>
                            }
                            <div class="d-flex flex-wrap gap-1 mt-2">
                                @if (!string.IsNullOrEmpty(Model.Color))
                                {
                                    <span class="badge rounded-pill bg-light text-dark border d-inline-flex align-items-center gap-1 fw-normal small">
                                        <span class="rounded-circle border"
                                            style="width:10px;height:10px;background:@Model.Color;display:inline-block"></span>
                                        @Model.Color
                                    </span>
                                }
                                @if (!string.IsNullOrEmpty(Model.Size))
                                {
                                    <span class="badge rounded-pill bg-light text-dark border fw-normal small">@Model.Size</span>
                                }
                                @if (!string.IsNullOrEmpty(Model.Material))
                                {
                                    <span class="badge rounded-pill bg-light text-dark border fw-normal small">@Model.Material</span>
                                }
                            </div>
                        </div>
                    </div>

                    <hr />

                    <div class="row g-2 small">
                        <div class="col-6">
                            <div class="d-flex justify-content-between align-items-center py-1 border-bottom">
                                <span class="text-muted">ID</span>
                                <code>#@Model.Id</code>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="d-flex justify-content-between align-items-center py-1 border-bottom">
                                <span class="text-muted">Price</span>
                                <span class="fw-semibold font-monospace">@Model.Price.ToString("N0") ₫</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="d-flex justify-content-between align-items-center py-1 border-bottom">
                                <span class="text-muted">Stock</span>
                                <span class="fw-semibold @(Model.Stock == 0 ? "text-danger" : Model.Stock <= 5 ? "text-warning" : "text-success")">
                                    @Model.Stock
                                </span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="d-flex justify-content-between align-items-center py-1 border-bottom">
                                <span class="text-muted">Status</span>
                                <span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary")">
                                    @(Model.IsActive ? "Active" : "Inactive")
                                </span>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <form asp-action="SoftDelete" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <div class="d-flex gap-2">
                    <button type="submit"
                            class="btn btn-warning d-flex align-items-center gap-2 flex-grow-1 justify-content-center">
                        <i class="bi bi-archive-fill"></i>Yes, Move to Trash
                    </button>
                    <a asp-action="Index" asp-route-productId="@productId"
                        class="btn btn-outline-secondary d-flex align-items-center gap-2 flex-grow-1 justify-content-center">
                        <i class="bi bi-x-circle"></i>Cancel
                    </a>
                </div>
            </form>

        </div>
    </div>
</div>

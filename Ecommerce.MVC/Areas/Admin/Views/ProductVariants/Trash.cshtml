@model IEnumerable<Ecommerce.Application.DTOs.Product.ProductVariantDto>
@using Ecommerce.Application.DTOs.Product

@{
    ViewData["Title"] = "Variant Trash";
    int productId   = (int)(ViewBag.ProductId   ?? 0);
    string productName = (string)(ViewBag.ProductName ?? "Product");
    var    list        = Model?.ToList() ?? new();
}

<div class="container-xxl py-4">

    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small mb-0">
            <li class="breadcrumb-item">
                <a asp-area="Admin" asp-controller="Products" asp-action="Index"
                class="text-decoration-none text-muted">Products</a>
            </li>
            <li class="breadcrumb-item">
                <a asp-area="Admin" asp-controller="Products" asp-action="Detail" asp-route-id="@productId"
                class="text-decoration-none text-muted">@productName</a>
            </li>
            <li class="breadcrumb-item">
                <a asp-area="Admin" asp-controller="ProductVariants" asp-action="Index" asp-route-productId="@productId" 
                class="text-decoration-none text-muted">Variants</a>
            </li>
            <li class="breadcrumb-item active fw-semibold">Trash</li>
        </ol>
    </nav>

    <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-4">
        <div>
            <h1 class="h4 fw-bold mb-0 d-flex align-items-center gap-2">
                <i class="bi bi-trash3 text-danger"></i>Variant Trash
            </h1>
            <p class="text-muted small mb-0 mt-1">
                Deleted variants of
                <a asp-area="Admin" asp-controller="Products" asp-action="Detail"
                asp-route-id="@productId"
                class="text-decoration-none fw-semibold text-dark">@productName</a>
            </p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            @if (list.Any())
            {
                <form asp-action="EmptyTrash" method="post"
                    onsubmit="return confirm('Permanently delete ALL @list.Count variant(s)? Cannot be undone.')">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productId" value="@productId" />
                    <button type="submit" class="btn btn-sm btn-danger d-flex align-items-center gap-1">
                        <i class="bi bi-trash3-fill"></i>Empty Trash (@list.Count)
                    </button>
                </form>
            }
            <a asp-area="Admin" asp-controller="ProductVariants"
                asp-action="Index" asp-route-productId="@productId"
                class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1">
                <i class="bi bi-arrow-left"></i>Back to Variants
            </a>
        </div>
    </div>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success alert-dismissible d-flex align-items-center gap-2 mb-4" role="alert">
            <i class="bi bi-check-circle-fill flex-shrink-0"></i>
            <div class="small">@success</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger alert-dismissible d-flex align-items-center gap-2 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
            <div class="small">@error</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="alert alert-warning d-flex align-items-start gap-3 mb-4" role="alert">
        <i class="bi bi-info-circle-fill flex-shrink-0 mt-1"></i>
        <div class="small">
            Variants in trash are <strong>hidden from storefront</strong>.
            Restore to make them active again, or permanently delete to remove all data including stock records.
        </div>
    </div>

    <div class="card border">

        <div class="card-header bg-transparent border-bottom py-3 px-4">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <span class="text-muted fw-bold text-uppercase small">
                    <i class="bi bi-archive me-1"></i>Trashed Variants
                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 ms-1">
                        @list.Count
                    </span>
                </span>
                @if (list.Any())
                {
                    <div class="input-group input-group-sm" style="width:220px">
                        <span class="input-group-text bg-transparent border-end-0">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        <input type="text" id="trashSearch"
                            class="form-control border-start-0 ps-0"
                            placeholder="Search name, SKU…" />
                    </div>
                }
            </div>
        </div>

        @if (!list.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-trash3 d-block mb-3 opacity-25" style="font-size:3rem"></i>
                <p class="fw-semibold mb-1">Trash is empty</p>
                <p class="small mb-3">No deleted variants for <strong>@productName</strong>.</p>
                <a asp-area="Admin" asp-controller="ProductVariants"
                    asp-action="Index" asp-route-productId="@productId"
                    class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Back to Variants
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4 py-3 border-0 text-muted fw-semibold text-uppercase" style="font-size:.7rem;letter-spacing:.06em">Variant</th>
                            <th class="py-3 border-0 text-muted fw-semibold text-uppercase" style="font-size:.7rem;letter-spacing:.06em">SKU</th>
                            <th class="py-3 border-0 text-muted fw-semibold text-uppercase" style="font-size:.7rem;letter-spacing:.06em">Attributes</th>
                            <th class="py-3 border-0 text-muted fw-semibold text-uppercase" style="font-size:.7rem;letter-spacing:.06em">Price</th>
                            <th class="py-3 border-0 text-muted fw-semibold text-uppercase" style="font-size:.7rem;letter-spacing:.06em">Stock</th>
                            <th class="py-3 border-0 text-muted fw-semibold text-uppercase" style="font-size:.7rem;letter-spacing:.06em">Status</th>
                            <th class="pe-4 py-3 border-0 text-muted fw-semibold text-uppercase text-end" style="font-size:.7rem;letter-spacing:.06em">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="trashBody">
                        @foreach (var v in list)
                        {
                            <tr data-name="@v.Name.ToLower()"
                                data-sku="@(v.SKU?.ToLower() ?? "")">

                                <td class="ps-4 py-3">
                                    <div class="d-flex align-items-center gap-3">
                                        @if (!string.IsNullOrEmpty(v.ImageUrl))
                                        {
                                            <img src="@v.ImageUrl" alt="@v.Name"
                                                class="rounded-2 border object-fit-cover flex-shrink-0 opacity-50"
                                                width="40" height="40"
                                                onerror="this.style.display='none'" />
                                        }
                                        else
                                        {
                                            <div class="rounded-2 border bg-light d-flex align-items-center justify-content-center flex-shrink-0 opacity-50"
                                                style="width:40px;height:40px">
                                                <i class="bi bi-image text-muted small"></i>
                                            </div>
                                        }
                                        <div>
                                            <div class="fw-semibold small text-muted text-decoration-line-through">@v.Name</div>
                                            <div class="text-muted" style="font-size:.72rem">ID #@v.Id</div>
                                        </div>
                                    </div>
                                </td>

                                <td><code class="small text-muted">@(v.SKU ?? "—")</code></td>

                                <td>
                                    <div class="d-flex flex-wrap gap-1">
                                        @if (!string.IsNullOrEmpty(v.Color))
                                        {
                                            <span class="badge rounded-pill bg-light text-dark border d-inline-flex align-items-center gap-1 fw-normal small">
                                                <span class="rounded-circle border flex-shrink-0"
                                                    style="width:10px;height:10px;background:@v.Color;display:inline-block"></span>
                                                @v.Color
                                            </span>
                                        }
                                        @if (!string.IsNullOrEmpty(v.Size))
                                        {
                                            <span class="badge rounded-pill bg-light text-dark border fw-normal small">@v.Size</span>
                                        }
                                        @if (!string.IsNullOrEmpty(v.Material))
                                        {
                                            <span class="badge rounded-pill bg-light text-dark border fw-normal small">@v.Material</span>
                                        }
                                        @if (string.IsNullOrEmpty(v.Color) && string.IsNullOrEmpty(v.Size) && string.IsNullOrEmpty(v.Material))
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                    </div>
                                </td>

                                <td>
                                    <span class="fw-bold font-monospace small text-muted">@v.Price.ToString("N0") ₫</span>
                                </td>

                                <td>
                                    <span class="small text-muted">@v.Stock</span>
                                </td>

                                <td>
                                    <span class="badge bg-secondary rounded-pill">Trashed</span>
                                </td>

                                <td class="pe-4 text-end">
                                    <div class="d-flex justify-content-end gap-1">

                                        <form asp-action="Restore" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="variantId"        value="@v.Id" />
                                            <input type="hidden" name="productId" value="@productId" />
                                            <button type="submit" class="btn btn-sm btn-outline-success"
                                                    onclick="return confirm('Restore \'@Html.Raw(v.Name.Replace("'", "\\'"))\'?')"
                                                    title="Restore">
                                                <i class="bi bi-arrow-counterclockwise me-1"></i>Restore
                                            </button>
                                        </form>

                                        <a asp-action="HardDelete"
                                            asp-route-variantId="@v.Id"
                                            asp-route-productId="@productId"
                                            class="btn btn-sm btn-outline-danger py-1 px-2"
                                            title="Delete permanently">
                                            <i class="bi bi-trash3-fill"></i>
                                        </a>

                                    </div>
                                </td>

                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="card-footer bg-transparent border-top px-4 py-2 d-flex align-items-center justify-content-between">
                <span class="small text-muted" id="trashCount">
                    <strong>@list.Count</strong> variant(s) in trash
                </span>
                <span class="small text-muted">
                    <i class="bi bi-clock-history me-1"></i>Most recently deleted first
                </span>
            </div>
        }
    </div>

</div>

@section Scripts {
    <script>
        const trashSearch = document.getElementById('trashSearch');
        const trashBody   = document.getElementById('trashBody');
        const trashCount  = document.getElementById('trashCount');

        trashSearch?.addEventListener('input', () => {
            const q = trashSearch.value.toLowerCase().trim();
            let visible = 0;
            trashBody?.querySelectorAll('tr').forEach(row => {
                const show = !q
                    || row.dataset.name.includes(q)
                    || row.dataset.sku.includes(q);
                row.classList.toggle('d-none', !show);
                if (show) visible++;
            });
            if (trashCount) trashCount.innerHTML = `<strong>${visible}</strong> variant(s) in trash`;
        });
    </script>
}

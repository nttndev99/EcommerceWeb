@model Ecommerce.Application.DTOs.Product.CreateProductVariantDto

@{
    ViewData["Title"] = "Add Variant";
    string productName = ViewBag.ProductName ?? "Product";
    int    productId   = ViewBag.ProductId   ?? 0;
}

<div class="container-xxl py-4">

    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small mb-0">
            <li class="breadcrumb-item">
                <a asp-controller="Products" asp-action="Index" class="text-decoration-none text-muted">Products</a>
            </li>
            <li class="breadcrumb-item">
                <a asp-controller="Products" asp-action="Detail" asp-route-id="@productId"
                   class="text-decoration-none text-muted">@productName</a>
            </li>
            <li class="breadcrumb-item">
                <a asp-action="Index" asp-route-productId="@productId"
                   class="text-decoration-none text-muted">Variants</a>
            </li>
            <li class="breadcrumb-item active fw-semibold">Add Variant</li>
        </ol>
    </nav>

    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h4 fw-bold mb-0">Add Variant</h1>
            <p class="text-muted small mb-0 mt-1">
                Adding variant to <span class="fw-semibold text-dark">@productName</span>
            </p>
        </div>
        <a asp-action="Index" asp-route-productId="@productId"
           class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back to Variants
        </a>
    </div>

    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger d-flex align-items-start gap-2 mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill flex-shrink-0 mt-1"></i>
        <div></div>
    </div>

    <form asp-action="Create" method="post" autocomplete="off">
        @Html.AntiForgeryToken()
        <input asp-for="ProductId" type="hidden" />

        <div class="row g-4 align-items-start">

            <div class="col-lg-8 d-flex flex-column gap-4">

                <div class="card border">
                    <div class="card-header bg-transparent border-bottom py-3 px-4">
                        <span class="text-muted fw-bold text-uppercase small">
                            <i class="bi bi-info-circle me-1"></i>Basic Information
                        </span>
                    </div>
                    <div class="card-body px-4 py-4 d-flex flex-column gap-3">

                        <div>
                            <label asp-for="Name" class="form-label fw-semibold small">
                                Variant Name <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Name" class="form-control"
                                   placeholder="e.g. Red / XL" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div>
                            <label asp-for="SKU" class="form-label fw-semibold small">SKU</label>
                            <input asp-for="SKU" class="form-control font-monospace"
                                   placeholder="e.g. NK-AM270-RED-XL" />
                            <span asp-validation-for="SKU" class="text-danger small"></span>
                        </div>

                        <div>
                            <label asp-for="ImageUrl" class="form-label fw-semibold small">
                                Image URL
                                <span class="text-muted fw-normal">(optional)</span>
                            </label>
                            <input asp-for="ImageUrl" class="form-control"
                                   placeholder="https://…"
                                   id="imageUrlInput" />
                            <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                            <div id="imagePreview" class="mt-2 d-none">
                                <img id="previewImg"
                                     src="" alt="Preview"
                                     class="rounded-3 border object-fit-cover"
                                     width="80" height="80" />
                            </div>
                        </div>

                    </div>
                </div>

                <div class="card border">
                    <div class="card-header bg-transparent border-bottom py-3 px-4">
                        <span class="text-muted fw-bold text-uppercase small">
                            <i class="bi bi-palette me-1"></i>Attributes
                        </span>
                    </div>
                    <div class="card-body px-4 py-4">
                        <div class="row g-3">

                            <div class="col-md-4">
                                <label asp-for="Color" class="form-label fw-semibold small">Color</label>
                                <div class="input-group">
                                    <input asp-for="Color" class="form-control"
                                           placeholder="e.g. Red"
                                           id="colorText" />
                                    <input type="color" class="form-control form-control-color border-start-0"
                                           id="colorPicker"
                                           title="Pick color" style="max-width:48px" />
                                </div>
                                <span asp-validation-for="Color" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Size" class="form-label fw-semibold small">Size</label>
                                <input asp-for="Size" class="form-control"
                                       placeholder="e.g. XL, 42, 10.5" />
                                <span asp-validation-for="Size" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Material" class="form-label fw-semibold small">Material</label>
                                <input asp-for="Material" class="form-control"
                                       placeholder="e.g. Cotton" />
                                <span asp-validation-for="Material" class="text-danger small"></span>
                            </div>

                        </div>
                    </div>
                </div>

                <div class="card border">
                    <div class="card-header bg-transparent border-bottom py-3 px-4">
                        <span class="text-muted fw-bold text-uppercase small">
                            <i class="bi bi-currency-exchange me-1"></i>Pricing
                        </span>
                    </div>
                    <div class="card-body px-4 py-4">
                        <div class="row g-3">

                            <div class="col-md-6">
                                <label asp-for="Price" class="form-label fw-semibold small">
                                    Price (₫) <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <input asp-for="Price" type="number" min="0" step="1000"
                                           class="form-control font-monospace"
                                           placeholder="0" />
                                    <span class="input-group-text text-muted">₫</span>
                                </div>
                                <span asp-validation-for="Price" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="SalePrice" class="form-label fw-semibold small">
                                    Sale Price (₫)
                                    <span class="text-muted fw-normal">(optional)</span>
                                </label>
                                <div class="input-group">
                                    <input asp-for="SalePrice" type="number" min="0" step="1000"
                                           class="form-control font-monospace"
                                           placeholder="Leave empty if no sale" />
                                    <span class="input-group-text text-muted">₫</span>
                                </div>
                                <span asp-validation-for="SalePrice" class="text-danger small"></span>
                                <div id="discountHint" class="form-text text-success d-none">
                                    <i class="bi bi-tag-fill me-1"></i><span id="discountValue"></span>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>

            </div>

            <div class="col-lg-4 d-flex flex-column gap-4">

                <div class="card border">
                    <div class="card-header bg-transparent border-bottom py-3 px-4">
                        <span class="text-muted fw-bold text-uppercase small">
                            <i class="bi bi-send me-1"></i>Publish
                        </span>
                    </div>
                    <div class="card-body px-4 py-3 d-flex flex-column gap-3">

                        <div class="form-check form-switch d-flex align-items-center gap-3 p-0">
                            <div class="flex-grow-1">
                                <div class="fw-semibold small">Active</div>
                                <div class="text-muted" style="font-size:.78rem">Visible to customers</div>
                            </div>
                            <input asp-for="IsActive"
                                   class="form-check-input ms-0 flex-shrink-0"
                                   role="switch"
                                   style="width:2.5rem;height:1.25rem;cursor:pointer" />
                        </div>

                        <div>
                            <label asp-for="DisplayOrder" class="form-label fw-semibold small">Display Order</label>
                            <input asp-for="DisplayOrder" type="number" min="0"
                                   class="form-control" />
                            <div class="form-text">Lower number shows first.</div>
                            <span asp-validation-for="DisplayOrder" class="text-danger small"></span>
                        </div>

                        <hr class="my-1" />

                        <div class="d-grid gap-2">
                            <button type="submit"
                                    class="btn btn-primary d-flex align-items-center justify-content-center gap-2">
                                <i class="bi bi-plus-circle-fill"></i>Add Variant
                            </button>
                            <a asp-action="Index" asp-route-productId="@productId"
                               class="btn btn-outline-secondary d-flex align-items-center justify-content-center gap-2">
                                <i class="bi bi-x-circle"></i>Cancel
                            </a>
                        </div>

                    </div>
                </div>

                <div class="card border bg-light">
                    <div class="card-body px-4 py-3">
                        <div class="fw-semibold small mb-2">
                            <i class="bi bi-lightbulb-fill text-warning me-1"></i>Tips
                        </div>
                        <ul class="small text-muted mb-0 ps-3 d-flex flex-column gap-1">
                            <li>Each variant can have its own price and stock.</li>
                            <li>Use Display Order to control sort position.</li>
                            <li>Color field accepts any CSS color value.</li>
                            <li>Set Sale Price lower than Price for a discount badge.</li>
                        </ul>
                    </div>
                </div>

            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        // Image URL preview
        const imageUrlInput = document.getElementById('imageUrlInput');
        const imagePreview  = document.getElementById('imagePreview');
        const previewImg    = document.getElementById('previewImg');

        imageUrlInput?.addEventListener('input', () => {
            const val = imageUrlInput.value.trim();
            if (val) {
                previewImg.src = val;
                imagePreview.classList.remove('d-none');
            } else {
                imagePreview.classList.add('d-none');
            }
        });

        // Color picker sync
        const colorText   = document.getElementById('colorText');
        const colorPicker = document.getElementById('colorPicker');

        colorPicker?.addEventListener('input', () => {
            colorText.value = colorPicker.value;
        });
        colorText?.addEventListener('input', () => {
            if (/^#[0-9A-Fa-f]{6}$/.test(colorText.value)) {
                colorPicker.value = colorText.value;
            }
        });

        // Live discount hint
        const priceInput   = document.querySelector('input[name="Price"]');
        const saleInput    = document.querySelector('input[name="SalePrice"]');
        const discHint     = document.getElementById('discountHint');
        const discVal      = document.getElementById('discountValue');

        function updateDiscount() {
            const price = parseFloat(priceInput?.value) || 0;
            const sale  = parseFloat(saleInput?.value)  || 0;
            if (price > 0 && sale > 0 && sale < price) {
                const disc = Math.round((price - sale) / price * 100);
                const save = (price - sale).toLocaleString('vi-VN');
                discVal.textContent = `${disc}% off · Save ${save} ₫`;
                discHint.classList.remove('d-none');
            } else {
                discHint.classList.add('d-none');
            }
        }

        priceInput?.addEventListener('input', updateDiscount);
        saleInput?.addEventListener('input', updateDiscount);
    </script>
}

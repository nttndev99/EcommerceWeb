@model IEnumerable<Ecommerce.Application.DTOs.Product.ProductVariantDto>
@using Ecommerce.Application.DTOs.Product

@{
    ViewData["Title"] = "Variants";
    int    productId   = ViewBag.ProductId   ?? 0;
    string productName = ViewBag.ProductName ?? "Product";
    var    list        = Model?.OrderBy(v => v.DisplayOrder).ToList() ?? new();

    int totalStock  = list.Sum(v => v.Stock);
    int activeCount = list.Count(v => v.IsActive);
    int outOfStock  = list.Count(v => v.Stock == 0);
}

<div class="container-xxl py-4">

    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small mb-0">
            <li class="breadcrumb-item">
                <a asp-area="Admin" asp-controller="Products" asp-action="Index"
                   class="text-decoration-none text-muted">Products</a>
            </li>
            <li class="breadcrumb-item">
                <a asp-area="Admin" asp-controller="Products" asp-action="Detail"
                   asp-route-id="@productId"
                   class="text-decoration-none text-muted">@productName</a>
            </li>
            <li class="breadcrumb-item active fw-semibold">Variants</li>
        </ol>
    </nav>

    <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-4">
        <div>
            <h1 class="h4 fw-bold mb-0">Variants</h1>
            <p class="text-muted small mb-0 mt-1">
                Managing variants for
                <a asp-area="Admin" asp-controller="Products" asp-action="Detail"
                asp-route-id="@productId"
                class="text-decoration-none fw-semibold text-dark">@productName</a>
            </p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-area="Admin" asp-controller="ProductVariants" asp-action="Trash" asp-route-id="@productId"
                class="btn btn-sm btn-outline-danger d-flex align-items-center gap-1">
                <i class="bi bi-trash3"></i>Trash
            </a>
            <a asp-area="Admin" asp-controller="Products" asp-action="Detail"
                asp-route-id="@productId"
                class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1">
                <i class="bi bi-arrow-left"></i>Product Detail
            </a>
            <a asp-action="Create" asp-route-productId="@productId"
                class="btn btn-sm btn-primary d-flex align-items-center gap-1">
                <i class="bi bi-plus-circle-fill"></i>Add Variant
            </a>
        </div>
    </div>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success alert-dismissible d-flex align-items-center gap-2 mb-4" role="alert">
            <i class="bi bi-check-circle-fill flex-shrink-0"></i>
            <div class="small">@success</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger alert-dismissible d-flex align-items-center gap-2 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
            <div class="small">@error</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border h-100">
                <div class="card-body d-flex align-items-center gap-3 py-3">
                    <div class="rounded-3 bg-primary bg-opacity-10 d-flex align-items-center justify-content-center flex-shrink-0"
                        style="width:42px;height:42px">
                        <i class="bi bi-grid-3x3-gap-fill text-primary"></i>
                    </div>
                    <div>
                        <div class="text-muted fw-semibold text-uppercase" style="font-size:.65rem;letter-spacing:.06em">Total</div>
                        <div class="fw-bold fs-5 font-monospace">@list.Count</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border h-100">
                <div class="card-body d-flex align-items-center gap-3 py-3">
                    <div class="rounded-3 bg-success bg-opacity-10 d-flex align-items-center justify-content-center flex-shrink-0"
                        style="width:42px;height:42px">
                        <i class="bi bi-check-circle-fill text-success"></i>
                    </div>
                    <div>
                        <div class="text-muted fw-semibold text-uppercase" style="font-size:.65rem;letter-spacing:.06em">Active</div>
                        <div class="fw-bold fs-5 font-monospace">@activeCount</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border h-100">
                <div class="card-body d-flex align-items-center gap-3 py-3">
                    <div class="rounded-3 bg-warning bg-opacity-10 d-flex align-items-center justify-content-center flex-shrink-0"
                        style="width:42px;height:42px">
                        <i class="bi bi-boxes text-warning"></i>
                    </div>
                    <div>
                        <div class="text-muted fw-semibold text-uppercase" style="font-size:.65rem;letter-spacing:.06em">Total Stock</div>
                        <div class="fw-bold fs-5 font-monospace @(totalStock == 0 ? "text-danger" : totalStock <= 10 ? "text-warning" : "")">
                            @totalStock
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border h-100">
                <div class="card-body d-flex align-items-center gap-3 py-3">
                    <div class="rounded-3 bg-danger bg-opacity-10 d-flex align-items-center justify-content-center flex-shrink-0"
                        style="width:42px;height:42px">
                        <i class="bi bi-exclamation-circle-fill text-danger"></i>
                    </div>
                    <div>
                        <div class="text-muted fw-semibold text-uppercase" style="font-size:.65rem;letter-spacing:.06em">Out of Stock</div>
                        <div class="fw-bold fs-5 font-monospace @(outOfStock > 0 ? "text-danger" : "")">@outOfStock</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border">

        <div class="card-header bg-transparent border-bottom py-3 px-4">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <span class="text-muted fw-bold text-uppercase small">
                    <i class="bi bi-list-ul me-1"></i>All Variants
                    <span class="badge bg-light text-muted border ms-1">@list.Count</span>
                </span>
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <div class="input-group input-group-sm" style="width:200px">
                        <span class="input-group-text bg-transparent border-end-0">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        <input type="text" id="variantSearch"
                            class="form-control border-start-0 ps-0"
                            placeholder="Search name, SKU…" />
                    </div>
                    <select id="statusFilter" class="form-select form-select-sm" style="width:120px">
                        <option value="">All Status</option>
                        <option value="active">Active</option>
                        <option value="inactive">Inactive</option>
                    </select>
                    <select id="stockFilter" class="form-select form-select-sm" style="width:120px">
                        <option value="">All Stock</option>
                        <option value="out">Out of Stock</option>
                        <option value="low">Low (≤5)</option>
                        <option value="ok">In Stock</option>
                    </select>
                </div>
            </div>
        </div>

        @if (!list.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-inbox d-block mb-3 opacity-25" style="font-size:3rem"></i>
                <p class="fw-semibold mb-1">No variants yet</p>
                <p class="small mb-3">Add the first variant for sizes, colors, or other options.</p>
                <a asp-action="Create" asp-route-productId="@productId"
                   class="btn btn-primary">
                    <i class="bi bi-plus-circle-fill me-1"></i>Add First Variant
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4 py-3 border-0 text-muted fw-semibold text-uppercase" style="font-size:.7rem;letter-spacing:.06em">Variant</th>
                            <th class="py-3 border-0 text-muted fw-semibold text-uppercase" style="font-size:.7rem;letter-spacing:.06em">SKU</th>
                            <th class="py-3 border-0 text-muted fw-semibold text-uppercase" style="font-size:.7rem;letter-spacing:.06em">Attributes</th>
                            <th class="py-3 border-0 text-muted fw-semibold text-uppercase" style="font-size:.7rem;letter-spacing:.06em">Price</th>
                            <th class="py-3 border-0 text-muted fw-semibold text-uppercase" style="font-size:.7rem;letter-spacing:.06em">Stock</th>
                            <th class="py-3 border-0 text-muted fw-semibold text-uppercase" style="font-size:.7rem;letter-spacing:.06em">Order</th>
                            <th class="py-3 border-0 text-muted fw-semibold text-uppercase" style="font-size:.7rem;letter-spacing:.06em">Status</th>
                            <th class="pe-4 py-3 border-0 text-muted fw-semibold text-uppercase text-end" style="font-size:.7rem;letter-spacing:.06em">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="variantBody">
                        @foreach (var v in list)
                        {
                            string stockData = v.Stock == 0 ? "out" : v.Stock <= 5 ? "low" : "ok";
                            string stockCls  = v.Stock == 0 ? "danger" : v.Stock <= 5 ? "warning" : "success";

                            <tr data-name="@v.Name.ToLower()"
                                data-sku="@(v.SKU?.ToLower() ?? "")"
                                data-status="@(v.IsActive ? "active" : "inactive")"
                                data-stock="@stockData">

                                <td class="ps-4 py-3">
                                    <div class="d-flex align-items-center gap-3">
                                        @if (!string.IsNullOrEmpty(v.ImageUrl))
                                        {
                                            <img src="@v.ImageUrl" alt="@v.Name"
                                                 class="rounded-2 border object-fit-cover flex-shrink-0"
                                                 width="40" height="40"
                                                 onerror="this.outerHTML='<div class=\'rounded-2 border bg-light d-flex align-items-center justify-content-center flex-shrink-0\' style=\'width:40px;height:40px\'><i class=\'bi bi-image text-muted small\'></i></div>'" />
                                        }
                                        else
                                        {
                                            <div class="rounded-2 border bg-light d-flex align-items-center justify-content-center flex-shrink-0"
                                                 style="width:40px;height:40px">
                                                <i class="bi bi-image text-muted small"></i>
                                            </div>
                                        }
                                        <div>
                                            <div class="fw-semibold small">@v.Name</div>
                                            <div class="text-muted" style="font-size:.72rem">ID #@v.Id</div>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    @if (!string.IsNullOrEmpty(v.SKU))
                                    {
                                        <code class="small text-muted">@v.SKU</code>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>

                                <td>
                                    <div class="d-flex flex-wrap gap-1">
                                        @if (!string.IsNullOrEmpty(v.Color))
                                        {
                                            <span class="badge rounded-pill bg-light text-dark border d-inline-flex align-items-center gap-1 fw-normal small">
                                                <span class="rounded-circle border flex-shrink-0"
                                                      style="width:10px;height:10px;background:@v.Color;display:inline-block"></span>
                                                @v.Color
                                            </span>
                                        }
                                        @if (!string.IsNullOrEmpty(v.Size))
                                        {
                                            <span class="badge rounded-pill bg-light text-dark border fw-normal small">
                                                <i class="bi bi-rulers me-1"></i>@v.Size
                                            </span>
                                        }
                                        @if (!string.IsNullOrEmpty(v.Material))
                                        {
                                            <span class="badge rounded-pill bg-light text-dark border fw-normal small">@v.Material</span>
                                        }
                                        @if (string.IsNullOrEmpty(v.Color) && string.IsNullOrEmpty(v.Size) && string.IsNullOrEmpty(v.Material))
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                    </div>
                                </td>

                                <td>
                                    <div class="fw-bold font-monospace small">@v.Price.ToString("N0") ₫</div>
                                    @if (v.SalePrice.HasValue && v.SalePrice.Value < v.Price)
                                    {
                                        int disc = (int)Math.Round((v.Price - v.SalePrice.Value) / v.Price * 100);
                                        <div class="d-flex align-items-center gap-1 mt-1">
                                            <span class="text-muted text-decoration-line-through font-monospace" style="font-size:.75rem">@v.SalePrice.Value.ToString("N0") ₫</span>
                                            <span class="badge bg-warning text-dark rounded-pill" style="font-size:.65rem">−@disc%</span>
                                        </div>
                                    }
                                </td>

                                <td>
                                    @if (v.Stock == 0)
                                    {
                                        <span class="badge bg-danger rounded-pill">Out</span>
                                    }
                                    else if (v.Stock <= 5)
                                    {
                                        <div class="d-flex align-items-center gap-1">
                                            <span class="badge bg-warning text-dark rounded-pill">Low</span>
                                            <span class="fw-semibold small text-warning">@v.Stock</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="fw-semibold small text-success">@v.Stock</span>
                                    }
                                </td>

                                <td>
                                    <span class="badge bg-light text-muted border rounded-pill px-2">@v.DisplayOrder</span>
                                </td>

                                <td>
                                    <span class="badge @(v.IsActive ? "bg-success" : "bg-secondary") rounded-pill">
                                        @(v.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>

                                <td class="pe-4 text-end">
                                    <div class="d-flex justify-content-end gap-1">
                                        <a asp-action="Edit" asp-route-id="@v.Id"
                                           class="btn btn-sm btn-outline-secondary py-1 px-2"
                                           title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-area="Admin" asp-controller="Inventories"
                                           asp-action="Adjust" asp-route-id="@v.Id" 
                                           class="btn btn-sm btn-outline-primary py-1 px-2"
                                           title="Adjust Stock">
                                            <i class="bi bi-boxes"></i>
                                        </a>
                                        <a asp-action="SoftDelete" asp-route-id="@v.Id"
                                           class="btn btn-sm btn-outline-danger py-1 px-2"
                                           title="Move to Trash">
                                            <i class="bi bi-trash3"></i>
                                        </a>
                                    </div>
                                </td>

                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="card-footer bg-transparent border-top px-4 py-2 d-flex align-items-center justify-content-between">
                <span class="small text-muted" id="rowCount">
                    Showing <strong>@list.Count</strong> variant(s)
                </span>
                <a asp-area="Admin" asp-controller="ProductVariants" asp-action="Trash"
                   class="small text-danger text-decoration-none">
                    <i class="bi bi-trash3 me-1"></i>View Trash
                </a>
            </div>
        }
    </div>

</div>

@section Scripts {
    <script>
        const searchInput  = document.getElementById('variantSearch');
        const statusFilter = document.getElementById('statusFilter');
        const stockFilter  = document.getElementById('stockFilter');
        const tbody        = document.getElementById('variantBody');
        const rowCount     = document.getElementById('rowCount');

        function filterRows() {
            if (!tbody) return;
            const q      = searchInput.value.toLowerCase().trim();
            const status = statusFilter.value;
            const stock  = stockFilter.value;
            let visible  = 0;

            tbody.querySelectorAll('tr').forEach(row => {
                const matchSearch = !q      || row.dataset.name.includes(q) || row.dataset.sku.includes(q);
                const matchStatus = !status || row.dataset.status === status;
                const matchStock  = !stock  || row.dataset.stock  === stock;
                const show = matchSearch && matchStatus && matchStock;
                row.classList.toggle('d-none', !show);
                if (show) visible++;
            });

            if (rowCount) rowCount.innerHTML = `Showing <strong>${visible}</strong> variant(s)`;
        }

        searchInput?.addEventListener('input',  filterRows);
        statusFilter?.addEventListener('change', filterRows);
        stockFilter?.addEventListener('change',  filterRows);
    </script>
}

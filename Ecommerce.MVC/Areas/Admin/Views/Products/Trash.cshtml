@model Ecommerce.Application.Common.PagedResult<Ecommerce.Application.DTOs.Product.ProductListDto>
@using Ecommerce.Application.DTOs.Product;

@{
    ViewData["Title"] = "Product Trash";
    var filter = ViewBag.Filter as ProductFilterParams ?? new ProductFilterParams();
}

<div class="container-fluid px-4 py-4">

    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h4 class="fw-semibold mb-0">
                <i class="bi bi-trash me-2 text-muted"></i>Trash
            </h4>
            <small class="text-muted">Soft-deleted products — restore or permanently remove</small>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3">
            <i class="bi bi-arrow-left me-1"></i> Back to Active
        </a>
    </div>

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-bottom d-flex flex-wrap align-items-center gap-2 py-3">

            <ul class="nav nav-pills me-auto gap-1">
                <li class="nav-item">
                    <a asp-action="Index" class="nav-link text-muted px-3 py-1">Active</a>
                </li>
                <li class="nav-item">
                    <a asp-action="Trash" class="nav-link active px-3 py-1">
                        <i class="bi bi-trash me-1"></i> Trash
                        <span class="badge bg-danger ms-1">@Model.TotalCount</span>
                    </a>
                </li>
            </ul>

            <form method="get" class="d-flex align-items-center gap-2">
                <div class="input-group input-group-sm" style="width:220px">
                    <span class="input-group-text bg-white border-end-0">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input type="text" name="search" value="@filter.Search"
                        class="form-control border-start-0 ps-0"
                        placeholder="Search trash…" />
                </div>
                <button type="submit" class="btn btn-outline-secondary btn-sm">Search</button>
            </form>
        </div>

        <div class="alert alert-warning d-flex align-items-start gap-2 rounded-0 border-0 border-bottom mb-0 py-2 px-4 small">
            <i class="bi bi-exclamation-triangle-fill mt-1 flex-shrink-0"></i>
            <span>
                Items here can be <strong>restored</strong> or <strong>permanently deleted</strong>.
                Hard delete <strong>cannot be undone</strong>.
            </span>
        </div>

        @if (!Model.Items.Any())
        {
            <div class="card-body text-center py-5 text-muted">
                <i class="bi bi-trash display-4 d-block mb-2"></i>
                <p class="mb-0">Trash is empty.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 small">
                    <thead class="table-light text-uppercase" style="font-size:.7rem;letter-spacing:.05em">
                        <tr>
                            <th>Name</th>
                            <th>Slug</th>
                            <th>Parent</th>
                            <th>Status</th>
                            <th class="text-center">Products</th>
                            <th>Created</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="rounded-circle bg-secondary bg-opacity-10 d-flex align-items-center justify-content-center"
                                            style="width:30px;height:30px;flex-shrink:0">
                                            <i class="bi bi-folder2 text-secondary" style="font-size:.8rem"></i>
                                        </span>
                                        <span class="fw-medium text-muted">@item.Name</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge rounded-pill bg-light text-secondary border fw-normal">
                                        <i class="bi bi-tag me-1" style="font-size:.65rem"></i>@item.Slug
                                    </span>
                                </td>
                                <td class="text-muted">@(item.CategoryName ?? "—")</td>
                                <td>
                                    <span class="badge bg-danger bg-opacity-10 text-danger fw-normal">
                                        <i class="bi bi-circle-fill me-1" style="font-size:.4rem;vertical-align:middle"></i>Deleted
                                    </span>
                                </td>
                                <td class="text-center text-muted">@item.TotalStock</td>
                                <td class="text-muted text-nowrap">@item.CreatedAt.ToString("dd/MM/yyyy")</td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-1">
                                        <form asp-action="Restore" asp-route-id="@item.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-success"
                                                    onclick="return confirm('Restore \'@item.Name\'?')" title="Restore">
                                                <i class="bi bi-arrow-counterclockwise me-1"></i>Restore
                                            </button>
                                        </form>
                                        <a asp-action="HardDelete" asp-route-id="@item.Id"
                                        class="btn btn-sm btn-outline-danger" title="Delete Permanently">
                                            <i class="bi bi-x-circle me-1"></i>Delete Forever
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.TotalPages > 1)
            {
                <div class="card-footer bg-white border-top d-flex align-items-center justify-content-between flex-wrap gap-2 py-3">
                    <small class="text-muted">
                        <strong>@Model.TotalCount</strong> items in trash
                    </small>
                    <nav>
                        <ul class="pagination pagination-sm mb-0 gap-1">
                            <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                                <a class="page-link rounded" asp-action="Trash"
                                asp-route-pageNumber="@(Model.PageNumber - 1)"
                                asp-route-search="@filter.Search">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>
                            @for (int p = 1; p <= Model.TotalPages; p++)
                            {
                                <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                                    <a class="page-link rounded" asp-action="Trash"
                                    asp-route-pageNumber="@p"
                                    asp-route-search="@filter.Search">@p</a>
                                </li>
                            }
                            <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                                <a class="page-link rounded" asp-action="Trash"
                                asp-route-pageNumber="@(Model.PageNumber + 1)"
                                asp-route-search="@filter.Search">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        }
    </div>
</div>

@await Html.PartialAsync("_ProductToast")

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.toast').forEach(el => {
                new bootstrap.Toast(el, { delay: 3500 }).show();
            });
        });
    </script>
}



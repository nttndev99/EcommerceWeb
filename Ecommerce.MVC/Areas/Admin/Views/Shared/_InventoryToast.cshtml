@if (TempData["Success"] != null)
{
    <div class="prd-toast prd-toast--success" role="alert">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
        @TempData["Success"]
    </div>
}
@if (TempData["Warning"] != null)
{
    <div class="prd-toast prd-toast--warning" role="alert">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0zM12 9v4M12 17h.01"/></svg>
        @TempData["Warning"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="prd-toast prd-toast--error" role="alert">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
        @TempData["Error"]
    </div>
}
@if (TempData["Danger"] != null)
{
    <div class="prd-toast prd-toast--error" role="alert">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"/></svg>
        @TempData["Danger"]
    </div>
}

<script>
    document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.prd-toast').forEach(t => {
            setTimeout(() => { t.style.transition = 'opacity .4s'; t.style.opacity = '0'; }, 3200);
            setTimeout(() => t.remove(), 3700);
        });
    });
</script>

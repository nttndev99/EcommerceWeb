<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Ecommerce</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        *, *::before, *::after { box-sizing: border-box; }

        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f4f5f7;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            padding: 1.5rem;
        }

        .auth-card {
            background: #fff;
            border-radius: 16px;
            box-shadow: 0 4px 24px rgba(0,0,0,.08);
            padding: 2.5rem 2rem;
            width: 100%;
            max-width: 420px;
        }

        .auth-header { text-align: center; margin-bottom: 2rem; }

        .auth-logo {
            width: 56px; height: 56px;
            border-radius: 14px;
            background: #111;
            color: #fff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            margin-bottom: 1rem;
        }
        .auth-logo--success { background: #16a34a; }
        .auth-logo--warning { background: #d97706; }
        .auth-logo--danger  { background: #dc2626; }

        .auth-title    { font-size: 1.35rem; font-weight: 700; color: #111; margin-bottom: .3rem; }
        .auth-subtitle { font-size: .9rem; color: #6b7280; margin: 0; line-height: 1.5; }

        .auth-form { display: flex; flex-direction: column; gap: .1rem; }

        .form-group  { margin-bottom: 1rem; }
        .form-label  { font-size: .85rem; font-weight: 500; color: #374151; margin-bottom: .35rem; display: block; }

        .input-wrapper { position: relative; }

        .input-icon {
            position: absolute; left: .85rem; top: 50%; transform: translateY(-50%);
            color: #9ca3af; font-size: .9rem; pointer-events: none;
        }

        .auth-input {
            width: 100%;
            padding: .65rem .85rem .65rem 2.4rem;
            border: 1.5px solid #e5e7eb;
            border-radius: 10px;
            font-size: .9rem;
            background: #fafafa;
            transition: border-color .15s, box-shadow .15s;
            outline: none;
        }
        .auth-input:focus {
            border-color: #111;
            box-shadow: 0 0 0 3px rgba(17,17,17,.08);
            background: #fff;
        }
        .auth-input.input-validation-error { border-color: #dc2626; }

        .input-toggle {
            position: absolute; right: .75rem; top: 50%; transform: translateY(-50%);
            background: none; border: none; color: #9ca3af; cursor: pointer; padding: .25rem;
            font-size: .95rem; line-height: 1;
        }
        .input-toggle:hover { color: #374151; }

        .field-error {
            display: block; font-size: .78rem; color: #dc2626; margin-top: .25rem;
        }

        .auth-error {
            background: #fef2f2; border: 1px solid #fecaca; border-radius: 8px;
            color: #dc2626; font-size: .85rem; padding: .65rem .85rem; margin-bottom: 1rem;
        }
        .auth-error:empty { display: none; }

        .btn-auth {
            display: block; width: 100%; padding: .7rem;
            background: #111; color: #fff; font-weight: 600; font-size: .9rem;
            border: none; border-radius: 10px; cursor: pointer;
            transition: background .15s, transform .1s;
            text-decoration: none; text-align: center;
            margin-top: .5rem;
        }
        .btn-auth:hover   { background: #333; color: #fff; }
        .btn-auth:active  { transform: scale(.98); }

        .btn-auth-outline {
            display: block; width: 100%; padding: .7rem;
            background: transparent; color: #111; font-weight: 600; font-size: .9rem;
            border: 1.5px solid #e5e7eb; border-radius: 10px; cursor: pointer;
            text-decoration: none; text-align: center;
            transition: border-color .15s;
        }
        .btn-auth-outline:hover { border-color: #111; color: #111; }

        .auth-footer {
            text-align: center; margin-top: 1.5rem;
            font-size: .85rem; color: #6b7280;
        }

        .auth-link       { color: #111; font-weight: 600; text-decoration: none; }
        .auth-link:hover { text-decoration: underline; }
        .auth-link-small { font-size: .8rem; color: #6b7280; text-decoration: none; }
        .auth-link-small:hover { color: #111; text-decoration: underline; }

        .auth-info-box {
            background: #f0f9ff; border: 1px solid #bae6fd;
            border-radius: 8px; color: #0369a1;
            font-size: .85rem; padding: .75rem 1rem;
            margin-bottom: 1.25rem; line-height: 1.5;
        }

        .form-check-input:checked { background-color: #111; border-color: #111; }
    </style>
</head>
<body>
    @RenderBody()

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function togglePassword(inputId, btn) {
            const input = document.getElementById(inputId);
            const icon  = btn.querySelector('i');
            if (input.type === 'password') {
                input.type = 'text';
                icon.className = 'bi bi-eye-slash';
            } else {
                input.type = 'password';
                icon.className = 'bi bi-eye';
            }
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

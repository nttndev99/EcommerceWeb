@model IEnumerable<Ecommerce.Application.DTOs.Admin.RoleDto>
@using Ecommerce.Application.DTOs.Admin

@{ ViewData["Title"] = "Roles Manager"; }

<div class="container-fluid px-4 py-4">

    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h4 class="fw-semibold mb-0">Roles Manager</h4>
            <small class="text-muted">Manage system roles and permissions</small>
        </div>
        <button class="btn btn-dark btn-sm px-3" data-bs-toggle="modal" data-bs-target="#createRoleModal">
            <i class="bi bi-plus me-1"></i>New Role
        </button>
    </div>

    <div class="row g-3 mb-4">
        @foreach (var role in Model)
        {
            <div class="col-md-4">
                <div class="card border h-100">
                    <div class="card-body d-flex align-items-center gap-3 py-3 px-4">
                        <div class="rounded-3 bg-primary bg-opacity-10 d-flex align-items-center justify-content-center flex-shrink-0"
                             style="width:46px;height:46px">
                            <i class="bi bi-shield-fill text-primary"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div class="fw-bold">@role.Name</div>
                            <div class="text-muted small">@role.UserCount user(s)</div>
                        </div>
                        <div class="d-flex gap-1">
                            <a asp-action="Detail" asp-route-id="@role.Id"
                               class="btn btn-light btn-sm" title="View users">
                                <i class="bi bi-people"></i>
                            </a>
                            @if (role.UserCount == 0)
                            {
                                <form asp-action="Delete" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@role.Id" />
                                    <button type="submit" class="btn btn-light btn-sm text-danger"
                                            onclick="return confirm('Delete role @role.Name?')"
                                            title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<div class="modal fade" id="createRoleModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-bottom">
                <h6 class="modal-title fw-semibold">Create New Role</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <label class="form-label fw-medium small">Role Name <span class="text-danger">*</span></label>
                    <input name="Name" type="text" class="form-control"
                           placeholder="e.g. Manager, Editor…" required />
                </div>
                <div class="modal-footer border-top">
                    <button type="button" class="btn btn-outline-secondary btn-sm"
                            data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-dark btn-sm px-3">Create Role</button>
                </div>
            </form>
        </div>
    </div>
</div>

@await Html.PartialAsync("_AdminToast")

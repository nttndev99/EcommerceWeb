@model Ecommerce.Application.DTOs.Order.OrderDto
@using Ecommerce.Domain.Enums

@{
    ViewData["Title"] = $"Order {Model.OrderCode}";

    string OrderStatusBadge(OrderStatus s) => s switch
    {
        OrderStatus.Pending    => "bg-warning text-dark",
        OrderStatus.Processing => "bg-primary",
        OrderStatus.Shipped    => "bg-info text-dark",
        OrderStatus.Delivered  => "bg-success",
        OrderStatus.Cancelled  => "bg-danger",
        _                      => "bg-secondary",
    };

    string PaymentBadge(PaymentStatus s) => s switch
    {
        PaymentStatus.Paid     => "bg-success",
        PaymentStatus.Unpaid   => "bg-warning text-dark",
        PaymentStatus.Refunded => "bg-secondary",
        PaymentStatus.Failed   => "bg-danger",
        _                      => "bg-secondary",
    };

    // Next valid status transitions
    var nextStatuses = Model.OrderStatus switch
    {
        OrderStatus.Pending    => new[] { OrderStatus.Processing, OrderStatus.Cancelled },
        OrderStatus.Processing => new[] { OrderStatus.Shipped,    OrderStatus.Cancelled },
        OrderStatus.Shipped    => new[] { OrderStatus.Delivered,  OrderStatus.Cancelled },
        _                      => Array.Empty<OrderStatus>(),
    };
}

<div class="container-xxl py-4">

    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small mb-0">
            <li class="breadcrumb-item">
                <a asp-action="Index" class="text-decoration-none text-muted">Orders</a>
            </li>
            <li class="breadcrumb-item active fw-semibold">@Model.OrderCode</li>
        </ol>
    </nav>

    <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center flex-wrap gap-2 mb-1">
                <h1 class="h4 fw-bold mb-0 font-monospace">@Model.OrderCode</h1>
                <span class="badge @OrderStatusBadge(Model.OrderStatus) rounded-pill">@Model.OrderStatus</span>
                <span class="badge @PaymentBadge(Model.PaymentStatus) rounded-pill">@Model.PaymentStatus</span>
            </div>
            <div class="small text-muted">
                <i class="bi bi-calendar3 me-1"></i>@Model.CreatedAt.ToString("dd MMM yyyy, HH:mm")
            </div>
        </div>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back
        </a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border h-100">
                <div class="card-body d-flex align-items-center gap-3 py-3">
                    <div class="rounded-3 bg-primary bg-opacity-10 d-flex align-items-center justify-content-center flex-shrink-0"
                         style="width:42px;height:42px">
                        <i class="bi bi-receipt text-primary"></i>
                    </div>
                    <div>
                        <div class="text-muted fw-semibold text-uppercase" style="font-size:.65rem;letter-spacing:.06em">Subtotal</div>
                        <div class="fw-bold font-monospace">@Model.SubTotal.ToString("N0") ₫</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border h-100">
                <div class="card-body d-flex align-items-center gap-3 py-3">
                    <div class="rounded-3 bg-info bg-opacity-10 d-flex align-items-center justify-content-center flex-shrink-0"
                         style="width:42px;height:42px">
                        <i class="bi bi-truck text-info"></i>
                    </div>
                    <div>
                        <div class="text-muted fw-semibold text-uppercase" style="font-size:.65rem;letter-spacing:.06em">Shipping</div>
                        <div class="fw-bold font-monospace">@Model.ShippingFee.ToString("N0") ₫</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border h-100">
                <div class="card-body d-flex align-items-center gap-3 py-3">
                    <div class="rounded-3 bg-warning bg-opacity-10 d-flex align-items-center justify-content-center flex-shrink-0"
                         style="width:42px;height:42px">
                        <i class="bi bi-tag text-warning"></i>
                    </div>
                    <div>
                        <div class="text-muted fw-semibold text-uppercase" style="font-size:.65rem;letter-spacing:.06em">Discount</div>
                        <div class="fw-bold font-monospace">-@Model.DiscountAmount.ToString("N0") ₫</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border h-100">
                <div class="card-body d-flex align-items-center gap-3 py-3">
                    <div class="rounded-3 bg-success bg-opacity-10 d-flex align-items-center justify-content-center flex-shrink-0"
                         style="width:42px;height:42px">
                        <i class="bi bi-cash-stack text-success"></i>
                    </div>
                    <div>
                        <div class="text-muted fw-semibold text-uppercase" style="font-size:.65rem;letter-spacing:.06em">Total</div>
                        <div class="fw-bold font-monospace text-success">@Model.Total.ToString("N0") ₫</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 align-items-start">

        <div class="col-lg-8 d-flex flex-column gap-4">

            <div class="card border">
                <div class="card-header bg-transparent border-bottom py-3 px-4 d-flex align-items-center gap-2">
                    <span class="text-muted fw-bold text-uppercase small">
                        <i class="bi bi-bag me-1"></i>Items
                    </span>
                    <span class="badge bg-light text-muted border small">@Model.Items.Count</span>
                </div>
                <div class="table-responsive">
                    <table class="table align-middle mb-0 small">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4 py-3 border-0 text-muted fw-semibold text-uppercase small" style="font-size:.7rem">Product</th>
                                <th class="py-3 border-0 text-muted fw-semibold text-uppercase small" style="font-size:.7rem">SKU</th>
                                <th class="py-3 border-0 text-muted fw-semibold text-uppercase small text-end" style="font-size:.7rem">Unit Price</th>
                                <th class="py-3 border-0 text-muted fw-semibold text-uppercase small text-center" style="font-size:.7rem">Qty</th>
                                <th class="pe-4 py-3 border-0 text-muted fw-semibold text-uppercase small text-end" style="font-size:.7rem">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="ps-4 py-3">
                                        <div class="d-flex align-items-center gap-2">
                                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                                            {
                                                <img src="@item.ImageUrl" width="36" height="36"
                                                     class="rounded-2 border object-fit-cover flex-shrink-0"
                                                     onerror="this.style.display='none'" />
                                            }
                                            <div>
                                                <div class="fw-semibold">@item.ProductName</div>
                                                @if (!string.IsNullOrEmpty(item.VariantName))
                                                {
                                                    <div class="text-muted" style="font-size:.75rem">@item.VariantName</div>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td><code class="small text-muted">@(item.SKU ?? "—")</code></td>
                                    <td class="text-end font-monospace">@item.UnitPrice.ToString("N0") ₫</td>
                                    <td class="text-center">@item.Quantity</td>
                                    <td class="pe-4 text-end fw-bold font-monospace">@item.TotalPrice.ToString("N0") ₫</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="border-top">
                            <tr>
                                <td colspan="4" class="pe-0 text-end text-muted small ps-4 py-2">Subtotal</td>
                                <td class="pe-4 text-end font-monospace small">@Model.SubTotal.ToString("N0") ₫</td>
                            </tr>
                            <tr>
                                <td colspan="4" class="pe-0 text-end text-muted small ps-4 py-2">Shipping</td>
                                <td class="pe-4 text-end font-monospace small">@Model.ShippingFee.ToString("N0") ₫</td>
                            </tr>
                            @if (Model.DiscountAmount > 0)
                            {
                                <tr>
                                    <td colspan="4" class="pe-0 text-end text-muted small ps-4 py-2">
                                        Discount @(!string.IsNullOrEmpty(Model.CouponCode) ? $"({Model.CouponCode})" : "")
                                    </td>
                                    <td class="pe-4 text-end font-monospace small text-danger">-@Model.DiscountAmount.ToString("N0") ₫</td>
                                </tr>
                            }
                            <tr class="fw-bold">
                                <td colspan="4" class="pe-0 text-end ps-4 py-2">Total</td>
                                <td class="pe-4 text-end font-monospace text-success">@Model.Total.ToString("N0") ₫</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <div class="card border">
                <div class="card-header bg-transparent border-bottom py-3 px-4">
                    <span class="text-muted fw-bold text-uppercase small">
                        <i class="bi bi-clock-history me-1"></i>Timeline
                    </span>
                </div>
                <div class="card-body px-4 py-3">
                    <ul class="list-unstyled mb-0">
                        @{
                            void TimelineRow(string icon, string label, DateTime? dt, string color = "secondary")
                            {
                                <li class="d-flex align-items-start gap-3 pb-3">
                                    <div class="rounded-circle bg-@color bg-opacity-10 d-flex align-items-center justify-content-center flex-shrink-0"
                                         style="width:32px;height:32px;margin-top:2px">
                                        <i class="bi bi-@icon text-@color" style="font-size:.8rem"></i>
                                    </div>
                                    <div>
                                        <div class="fw-semibold small">@label</div>
                                        <div class="text-muted" style="font-size:.75rem">
                                            @(dt.HasValue ? dt.Value.ToString("dd MMM yyyy, HH:mm") : "—")
                                        </div>
                                    </div>
                                </li>
                            }
                        }
                        @{ TimelineRow("bag-plus",   "Order Placed",   Model.CreatedAt,   "primary"); }
                        @{ TimelineRow("gear",        "Processing",     Model.OrderStatus >= OrderStatus.Processing ? Model.CreatedAt : null, "info"); }
                        @{ TimelineRow("truck",       "Shipped",        Model.ShippedAt,   "info"); }
                        @{ TimelineRow("check-circle","Delivered",      Model.DeliveredAt, "success"); }
                        @if (Model.PaidAt.HasValue)
                        {
                            TimelineRow("credit-card", "Paid", Model.PaidAt, "success");
                        }
                        @if (Model.CancelledAt.HasValue)
                        {
                            TimelineRow("x-circle", "Cancelled", Model.CancelledAt, "danger");
                        }
                    </ul>
                </div>
            </div>

        </div>

        <div class="col-lg-4 d-flex flex-column gap-4">

            @if (nextStatuses.Any())
            {
                <div class="card border">
                    <div class="card-header bg-transparent border-bottom py-3 px-4">
                        <span class="text-muted fw-bold text-uppercase small">
                            <i class="bi bi-arrow-repeat me-1"></i>Update Status
                        </span>
                    </div>
                    <div class="card-body px-4 py-3 d-grid gap-2">
                        @foreach (var ns in nextStatuses.Where(s => s != OrderStatus.Cancelled))
                        {
                            <form asp-action="UpdateStatus" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="Id"          value="@Model.Id" />
                                <input type="hidden" name="OrderStatus" value="@((int)ns)" />
                                <button type="submit" class="btn btn-primary btn-sm w-100">
                                    <i class="bi bi-arrow-right-circle me-1"></i>Mark as @ns
                                </button>
                            </form>
                        }
                        @if (nextStatuses.Contains(OrderStatus.Cancelled))
                        {
                            <button class="btn btn-outline-danger btn-sm w-100"
                                    data-bs-toggle="modal" data-bs-target="#cancelModal">
                                <i class="bi bi-x-circle me-1"></i>Cancel Order
                            </button>
                        }
                    </div>
                </div>
            }

            <div class="card border">
                <div class="card-header bg-transparent border-bottom py-3 px-4">
                    <span class="text-muted fw-bold text-uppercase small">
                        <i class="bi bi-credit-card me-1"></i>Payment
                    </span>
                </div>
                <div class="card-body px-4 py-3">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="small text-muted">Method</span>
                        <span class="small fw-semibold">@Model.PaymentMethod</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="small text-muted">Status</span>
                        <span class="badge @PaymentBadge(Model.PaymentStatus) rounded-pill">@Model.PaymentStatus</span>
                    </div>
                    @if (Model.PaymentStatus == PaymentStatus.Unpaid)
                    {
                        <form asp-action="UpdatePayment" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="Id"            value="@Model.Id" />
                            <input type="hidden" name="PaymentStatus" value="@((int)PaymentStatus.Paid)" />
                            <button type="submit" class="btn btn-success btn-sm w-100">
                                <i class="bi bi-check2-circle me-1"></i>Mark as Paid
                            </button>
                        </form>
                    }
                    @if (Model.PaymentStatus == PaymentStatus.Paid)
                    {
                        <form asp-action="UpdatePayment" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="Id"            value="@Model.Id" />
                            <input type="hidden" name="PaymentStatus" value="@((int)PaymentStatus.Refunded)" />
                            <button type="submit" class="btn btn-outline-secondary btn-sm w-100">
                                <i class="bi bi-arrow-counterclockwise me-1"></i>Mark as Refunded
                            </button>
                        </form>
                    }
                </div>
            </div>

            <div class="card border">
                <div class="card-header bg-transparent border-bottom py-3 px-4">
                    <span class="text-muted fw-bold text-uppercase small">
                        <i class="bi bi-geo-alt me-1"></i>Shipping Info
                    </span>
                </div>
                <div class="card-body px-4 py-2">
                    @{
                        void Row(string key, string? val)
                        {
                            <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                <span class="small text-muted">@key</span>
                                <span class="small fw-semibold text-end ms-3">@(val ?? "—")</span>
                            </div>
                        }
                    }
                    @{ Row("Name",     Model.RecipientName); }
                    @{ Row("Phone",    Model.RecipientPhone); }
                    @{ Row("Address",  Model.AddressLine); }
                    @{ Row("Ward",     Model.Ward); }
                    @{ Row("District", Model.District); }
                    @{ Row("Province", Model.Province); }
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.Note) || !string.IsNullOrEmpty(Model.CancelReason))
            {
                <div class="card border">
                    <div class="card-header bg-transparent border-bottom py-3 px-4">
                        <span class="text-muted fw-bold text-uppercase small">
                            <i class="bi bi-chat-left-text me-1"></i>Notes
                        </span>
                    </div>
                    <div class="card-body px-4 py-3 small">
                        @if (!string.IsNullOrEmpty(Model.Note))
                        {
                            <p class="mb-1 text-muted">@Model.Note</p>
                        }
                        @if (!string.IsNullOrEmpty(Model.CancelReason))
                        {
                            <p class="mb-0 text-danger">
                                <i class="bi bi-x-circle me-1"></i>@Model.CancelReason
                            </p>
                        }
                    </div>
                </div>
            }

        </div>
    </div>
</div>

<div class="modal fade" id="cancelModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-bottom">
                <h6 class="modal-title fw-semibold">Cancel Order</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Cancel" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="modal-body">
                    <p class="small text-muted mb-3">
                        Are you sure you want to cancel <strong>@Model.OrderCode</strong>?
                        Reserved stock will be released.
                    </p>
                    <label class="form-label fw-medium small">Reason <span class="text-danger">*</span></label>
                    <textarea name="reason" class="form-control form-control-sm" rows="3"
                              placeholder="Enter cancellation reason…" required></textarea>
                </div>
                <div class="modal-footer border-top">
                    <button type="button" class="btn btn-outline-secondary btn-sm"
                            data-bs-dismiss="modal">Dismiss</button>
                    <button type="submit" class="btn btn-danger btn-sm">
                        <i class="bi bi-x-circle me-1"></i>Confirm Cancel
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@await Html.PartialAsync("_OrderToast")

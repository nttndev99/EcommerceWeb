@model Ecommerce.Application.DTOs.Category.CategoryDto

@{
    ViewData["Title"] = Model.Name;
}

<div class="container-fluid px-4 py-4" style="max-width:860px">

    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small mb-0">
            <li class="breadcrumb-item">
                <a asp-action="Index" class="text-decoration-none">Categories</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
        <div class="d-flex align-items-center gap-3">
            <div class="rounded-circle d-flex align-items-center justify-content-center
                        @(Model.IsActive ? "bg-success" : "bg-secondary") bg-opacity-10"
                style="width:48px;height:48px;flex-shrink:0">
                <i class="bi bi-folder2 fs-5 @(Model.IsActive ? "text-success" : "text-secondary")"></i>
            </div>
            <div>
                <h4 class="fw-semibold mb-1">@Model.Name</h4>
                @if (Model.IsActive)
                {
                    <span class="badge bg-success bg-opacity-10 text-success fw-normal">
                        <i class="bi bi-circle-fill me-1" style="font-size:.45rem;vertical-align:middle"></i>Active
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary bg-opacity-10 text-secondary fw-normal">
                        <i class="bi bi-circle-fill me-1" style="font-size:.45rem;vertical-align:middle"></i>Inactive
                    </span>
                }
            </div>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-dark btn-sm px-3">
                <i class="bi bi-pencil me-1"></i> Edit
            </a>
            <a asp-action="SoftDelete" asp-route-id="@Model.Id" class="btn btn-outline-danger btn-sm px-3">
                <i class="bi bi-trash me-1"></i> Move to Trash
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white border-bottom py-3">
            <span class="fw-semibold text-uppercase small" style="letter-spacing:.05em">Details</span>
        </div>
        <div class="card-body p-0">
            <dl class="row g-0 mb-0 small">
                <div class="col-sm-6 d-flex gap-2 px-4 py-3 border-bottom border-end">
                    <dt class="text-muted fw-normal" style="min-width:100px">Slug</dt>
                    <dd class="mb-0 fw-medium font-monospace">@Model.Slug</dd>
                </div>
                <div class="col-sm-6 d-flex gap-2 px-4 py-3 border-bottom">
                    <dt class="text-muted fw-normal" style="min-width:100px">Parent</dt>
                    <dd class="mb-0 fw-medium">@(Model.ParentName ?? "—")</dd>
                </div>
                <div class="col-sm-6 d-flex gap-2 px-4 py-3 border-bottom border-end">
                    <dt class="text-muted fw-normal" style="min-width:100px">Display Order</dt>
                    <dd class="mb-0 fw-medium">@Model.DisplayOrder</dd>
                </div>
                <div class="col-sm-6 d-flex gap-2 px-4 py-3 border-bottom">
                    <dt class="text-muted fw-normal" style="min-width:100px">Products</dt>
                    <dd class="mb-0">
                        <span class="badge bg-primary bg-opacity-10 text-primary fw-semibold">@Model.ProductCount</span>
                    </dd>
                </div>
                <div class="col-sm-6 d-flex gap-2 px-4 py-3 border-end">
                    <dt class="text-muted fw-normal" style="min-width:100px">Created</dt>
                    <dd class="mb-0 fw-medium">@Model.CreatedAt.ToString("dd MMM yyyy")</dd>
                </div>
                <div class="col-sm-6 d-flex gap-2 px-4 py-3">
                    <dt class="text-muted fw-normal" style="min-width:100px">ID</dt>
                    <dd class="mb-0 fw-medium font-monospace text-muted">#@Model.Id</dd>
                </div>
            </dl>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Description))
    {
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-white border-bottom py-3">
                <span class="fw-semibold text-uppercase small" style="letter-spacing:.05em">Description</span>
            </div>
            <div class="card-body py-3">
                <p class="mb-0 text-secondary">@Model.Description</p>
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
    {
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-white border-bottom py-3">
                <span class="fw-semibold text-uppercase small" style="letter-spacing:.05em">Image</span>
            </div>
            <div class="card-body py-3">
                <img src="@Model.ImageUrl" alt="@Model.Name"
                    class="rounded-3 border mb-2"
                    style="max-width:200px;max-height:160px;object-fit:cover"
                    onerror="this.style.display='none'" />
                <p class="mb-0 font-monospace text-muted small">@Model.ImageUrl</p>
            </div>
        </div>
    }

    <div class="text-end mt-2">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3">
            <i class="bi bi-arrow-left me-1"></i> Back to List
        </a>
    </div>
</div>

@await Html.PartialAsync("_CategoryToast")

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.toast').forEach(el => {
                new bootstrap.Toast(el, { delay: 3500 }).show();
            });
        });
    </script>
}

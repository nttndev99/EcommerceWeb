@model Ecommerce.Application.Common.PagedResult<Ecommerce.Application.DTOs.Category.CategoryListDto>
@using Ecommerce.Application.DTOs.Category

@{
    ViewData["Title"] = "Categories Management";
    var filter = ViewBag.Filter as CategoryFilterParams ?? new CategoryFilterParams();

    string SortLink(string col) =>
        filter.SortBy == col && filter.SortDirection == "asc" ? "desc" : "asc";

    string SortIcon(string col)
    {
        if (filter.SortBy != col) return "bi bi-arrow-down-up text-muted opacity-50";
        return filter.SortDirection == "asc" ? "bi bi-arrow-up" : "bi bi-arrow-down";
    }

    Dictionary<string, string> RouteData(string sortCol) => new()
    {
        ["sortBy"]        = sortCol,
        ["sortDirection"] = SortLink(sortCol),
        ["search"]        = filter.Search ?? "",
        ["pageNumber"]    = "1",
        ["pageSize"]      = filter.PageSize.ToString()
    };

    Dictionary<string, string> PageRoute(int page) => new()
    {
        ["pageNumber"]    = page.ToString(),
        ["pageSize"]      = filter.PageSize.ToString(),
        ["search"]        = filter.Search ?? "",
        ["sortBy"]        = filter.SortBy ?? "",
        ["sortDirection"] = filter.SortDirection ?? ""
    };
}

<div class="container-fluid px-4 py-4">

    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h4 class="fw-semibold mb-0">Categories</h4>
            <small class="text-muted">Manage your product taxonomy</small>
        </div>
        <a asp-action="Create" class="btn btn-dark btn-sm px-3">
            <i class="bi bi-plus me-1"></i> New Category
        </a>
    </div>

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-bottom d-flex flex-wrap align-items-center gap-2 py-3">

            <ul class="nav nav-pills me-auto gap-1">
                <li class="nav-item">
                    <a asp-action="Index" class="nav-link active px-3 py-1">
                        Active
                        <span class="badge bg-dark ms-1">@Model.TotalCount</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-action="Trash" class="nav-link text-muted px-3 py-1">
                        <i class="bi bi-trash me-1"></i> Trash
                    </a>
                </li>
            </ul>

            <form method="get" class="d-flex align-items-center flex-wrap gap-2">
                <div class="input-group input-group-sm" style="width:220px">
                    <span class="input-group-text bg-white border-end-0">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input type="text" name="search" value="@filter.Search"
                        class="form-control border-start-0 ps-0"
                        placeholder="Search categories…" />
                </div>

                <select name="isActive" class="form-select form-select-sm" style="width:130px"
                        onchange="this.form.submit()">
                    <option value="">All status</option>
                    <option value="true"  selected="@(filter.IsActive == true)">Active</option>
                    <option value="false" selected="@(filter.IsActive == false)">Inactive</option>
                </select>

                <select name="pageSize" class="form-select form-select-sm" style="width:110px"
                        onchange="this.form.submit()">
                    @foreach (var size in new[] { 10, 25, 50 })
                    {
                        <option value="@size" selected="@(filter.PageSize == size)">@size / page</option>
                    }
                </select>

                <input type="hidden" name="sortBy"        value="@filter.SortBy" />
                <input type="hidden" name="sortDirection" value="@filter.SortDirection" />

                <button type="submit" class="btn btn-outline-secondary btn-sm">Apply</button>
            </form>
        </div>

        @if (!Model.Items.Any())
        {
            <div class="card-body text-center py-5 text-muted">
                <i class="bi bi-folder2-open display-4 d-block mb-2"></i>
                <p class="mb-0">No categories found.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 small">
                    <thead class="table-light text-uppercase" style="font-size:.7rem;letter-spacing:.05em">
                        <tr>
                            <th>
                                <a asp-action="Index" asp-all-route-data="@RouteData("name")"
                                    class="text-dark text-decoration-none d-flex align-items-center gap-1">
                                    Name <i class="@SortIcon("name")"></i>
                                </a>
                            </th>
                            <th>Slug</th>
                            <th>Parent</th>
                            <th class="text-center">
                                <a asp-action="Index" asp-all-route-data="@RouteData("displayorder")"
                                    class="text-dark text-decoration-none d-flex align-items-center justify-content-center gap-1">
                                    Order <i class="@SortIcon("displayorder")"></i>
                                </a>
                            </th>
                            <th>Status</th>
                            <th class="text-center">Products</th>
                            <th>
                                <a asp-action="Index" asp-all-route-data="@RouteData("createdat")"
                                    class="text-dark text-decoration-none d-flex align-items-center gap-1">
                                    Created <i class="@SortIcon("createdat")"></i>
                                </a>
                            </th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="rounded-circle d-flex align-items-center justify-content-center
                                                    @(item.IsActive ? "bg-success" : "bg-secondary") bg-opacity-10"
                                                    style="width:30px;height:30px;flex-shrink:0">
                                            <i class="bi bi-folder2 @(item.IsActive ? "text-success" : "text-secondary")"
                                                style="font-size:.8rem"></i>
                                        </span>
                                        <span class="fw-medium">@item.Name</span>
                                    </div>
                                </td>

                                <td>
                                    <span class="badge rounded-pill bg-light text-secondary border fw-normal">
                                        <i class="bi bi-tag me-1" style="font-size:.65rem"></i>@item.Slug
                                    </span>
                                </td>

                                <td class="text-muted">@(item.ParentName ?? "—")</td>

                                <td class="text-center text-muted">@item.DisplayOrder</td>

                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success fw-normal">
                                            <i class="bi bi-circle-fill me-1" style="font-size:.4rem;vertical-align:middle"></i>Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary fw-normal">
                                            <i class="bi bi-circle-fill me-1" style="font-size:.4rem;vertical-align:middle"></i>Inactive
                                        </span>
                                    }
                                </td>

                                <td class="text-center">
                                    @if (item.ProductCount > 0)
                                    {
                                        <span class="badge bg-primary bg-opacity-10 text-primary fw-normal">@item.ProductCount</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">0</span>
                                    }
                                </td>

                                <td class="text-muted text-nowrap">
                                    @item.CreatedAt.ToString("dd/MM/yyyy")
                                </td>

                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-1">
                                        <a asp-action="Detail" asp-route-id="@item.Id"
                                            class="btn btn-light btn-sm" title="View">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id"
                                            class="btn btn-light btn-sm" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="SoftDelete" asp-route-id="@item.Id"
                                            class="btn btn-light btn-sm text-danger" title="Move to Trash"
                                            onclick="return confirm('Move this category to trash?')">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="card-footer bg-white border-top d-flex align-items-center justify-content-between flex-wrap gap-2 py-3">
                <small class="text-muted">
                    Showing
                    <strong>@(((Model.PageNumber - 1) * Model.PageSize) + 1)</strong>–<strong>@(Math.Min(Model.PageNumber * Model.PageSize, Model.TotalCount))</strong>
                    of <strong>@Model.TotalCount</strong> categories
                </small>

                <nav>
                    <ul class="pagination pagination-sm mb-0 gap-1">
                        <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                            <a class="page-link rounded" asp-action="Index"
                            asp-all-route-data="@PageRoute(Model.PageNumber - 1)">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>

                        @for (int p = Math.Max(1, Model.PageNumber - 2); p <= Math.Min(Model.TotalPages, Model.PageNumber + 2); p++)
                        {
                            <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                                <a class="page-link rounded" asp-action="Index"
                                asp-all-route-data="@PageRoute(p)">@p</a>
                            </li>
                        }

                        <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link rounded" asp-action="Index"
                            asp-all-route-data="@PageRoute(Model.PageNumber + 1)">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

@await Html.PartialAsync("_CategoryToast")

@section Scripts {
    <script>
        // Auto-dismiss Bootstrap toasts
        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.toast').forEach(el => {
                const toast = new bootstrap.Toast(el, { delay: 3500 });
                toast.show();
            });
        });
    </script>
}

@using Ecommerce.Application.DTOs.Product
@using Ecommerce.Application.DTOs.Category
@{
    var cat        = ViewBag.Category   as CategoryListDto      ?? new CategoryListDto();
    var products   = ViewBag.Products   as List<ProductListDto> ?? new();
    var total      = (int)(ViewBag.TotalCount   ?? 0);
    var page       = (int)(ViewBag.CurrentPage  ?? 1);
    var totalPages = (int)(ViewBag.TotalPages   ?? 1);
    ViewData["Title"] = cat.Name;
}

<section class="breadcrumb-section set-bg spad"
         style="background-image:url('/img/breadcrumb.jpg');background-size:cover;background-position:center;padding:60px 0">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 text-center text-white">
                <div class="breadcrumb__text">
                    <h2>@cat.Name</h2>
                    <div class="breadcrumb__option">
                        <a asp-controller="Home" asp-action="Index" class="text-white-50">Home</a>
                        <span class="text-white-50 mx-2">/</span>
                        <span>@cat.Name</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="product spad">
    <div class="container">

        <div class="row">
            <div class="col-lg-12">
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <div>
                        <h4 class="fw-bold mb-0">@cat.Name</h4>
                        <div class="text-muted small">@total product(s) found</div>
                    </div>
                </div>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show py-2 small mb-3">
                <i class="bi bi-check-circle me-1"></i>@TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (!products.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-inbox display-1 d-block mb-3 opacity-25"></i>
                <h5>No products found in this category</h5>
                <a asp-controller="Home" asp-action="Index" class="primary-btn mt-3 d-inline-block">
                    Back to Home
                </a>
            </div>
        }
        else
        {
            <div class="row">
                @foreach (var p in products)
                {
                    <div class="col-lg-3 col-md-6 col-sm-6 mb-4">
                        @await Html.PartialAsync("_ProductCard", p)
                    </div>
                }
            </div>

            @if (totalPages > 1)
            {
                <div class="row">
                    <div class="col-lg-12 d-flex justify-content-center mt-3">
                        <nav>
                            <ul class="pagination">
                                <li class="page-item @(page <= 1 ? "disabled" : "")">
                                    <a class="page-link"
                                       asp-controller="Home" asp-action="Category"
                                       asp-route-slug="@cat.Slug"
                                       asp-route-page="@(page - 1)">
                                        <i class="bi bi-chevron-left"></i>
                                    </a>
                                </li>
                                @for (int i = Math.Max(1, page - 2); i <= Math.Min(totalPages, page + 2); i++)
                                {
                                    <li class="page-item @(i == page ? "active" : "")">
                                        <a class="page-link"
                                           asp-controller="Home" asp-action="Category"
                                           asp-route-slug="@cat.Slug"
                                           asp-route-page="@i">@i</a>
                                    </li>
                                }
                                <li class="page-item @(page >= totalPages ? "disabled" : "")">
                                    <a class="page-link"
                                       asp-controller="Home" asp-action="Category"
                                       asp-route-slug="@cat.Slug"
                                       asp-route-page="@(page + 1)">
                                        <i class="bi bi-chevron-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                </div>
            }
        }

    </div>
</section>

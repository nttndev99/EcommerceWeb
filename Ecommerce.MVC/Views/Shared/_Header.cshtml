<!-- Header Section Begin -->
<header class="header">

    <div class="header__top">
        <div class="container">
            <div class="row">

                @* ── Top-left: shipping notice ── *@
                <div class="col-lg-6 col-md-7">
                    <div class="header__top__left">
                        <p>Free shipping on orders over 500,000 ₫ &nbsp;·&nbsp; 30-day return guarantee.</p>
                    </div>
                </div>

                @* ── Top-right: auth + FAQs ── *@
                <div class="col-lg-6 col-md-5">
                    <div class="header__top__right">

                        @* ① Kiểm tra đăng nhập: User.Identity.IsAuthenticated *@
                        @if (User.Identity!.IsAuthenticated)
                        {
                            @* ── Đã đăng nhập → dropdown với tên người dùng ── *@
                            <div class="header__top__hover">
                                @* ② User.Identity.Name *@
                                <span>
                                    Hello, @User.Identity.Name
                                    <i class="arrow_carrot-down"></i>
                                </span>
                                <ul>
                                    <li>
                                        <a asp-controller="Orders" asp-action="Index">My Orders</a>
                                    </li>
                                    @* ③ Chỉ hiện Admin Panel khi có role "Admin" *@
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li>
                                            <a asp-area="Admin"
                                               asp-controller="Home"
                                               asp-action="Index">Admin Panel</a>
                                        </li>
                                    }
                                    <li>
                                        @* ⑥ Form logout kèm AntiForgeryToken *@
                                        <form asp-area="Admin"
                                              asp-controller="Auth"
                                              asp-action="Logout"
                                              method="post"
                                              class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="btn btn-link p-0 text-decoration-none">
                                                Logout
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            @* ── Chưa đăng nhập → Sign in / Sign up links ── *@
                            <div class="header__top__links">
                                <a asp-area="Admin"
                                   asp-controller="Auth"
                                   asp-action="Login">Sign in</a>
                                <a asp-area="Admin"
                                   asp-controller="Auth"
                                   asp-action="Register">Sign up</a>
                            </div>
                        }

                    </div>
                </div>

            </div>
        </div>
    </div>
    @* ── /TOP BAR ── *@


    @* ─────────────────────────────────────────
       MAIN HEADER ROW
       Col 1 : Logo
       Col 2 : Navigation + dropdown
       Col 3 : Search · Wishlist · Cart (CartBadge)
    ───────────────────────────────────────── *@
    <div class="container">
        <div class="row align-items-center">

            @* ── Col 1: Logo ── *@
            <div class="col-lg-3 col-md-3">
                <div class="header__logo">
                    <a asp-controller="Home" asp-action="Index">
                        @* Giữ nguyên <img> nếu có file logo thật
                           <img src="~/img/logo.png" alt="SHOP" />
                           Tạm dùng text logo giống source header *@
                        <span class="fw-bold fs-5 text-dark">LOGO</span>
                    </a>
                </div>
            </div>

            @* ── Col 2: Navigation ── *@
            <div class="col-lg-6 col-md-6">
                <nav class="header__menu mobile-menu">
                    <ul>

                        @* ④ Active class: so sánh RouteData controller + action *@
                        <li class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Home"
                                  && ViewContext.RouteData.Values["action"]?.ToString()    == "Index"
                                  ? "active" : "")">
                            <a asp-controller="Home" asp-action="Index">Home</a>
                        </li>

                        @* ── Shop (nếu có trang shop riêng) ── *@
                        @* <li class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Shop"
                                  ? "active" : "")">
                            <a asp-controller="Home" asp-action="Shop">Shop</a>
                        </li> *@

                        @* ── Categories dropdown ── *@
                        @await Component.InvokeAsync("CategoryMenu")

                        @* ── Pages dropdown (từ template gốc, giữ lại) ── *@
                        <li>
                            <a href="#">Pages <i class="arrow_carrot-down"></i></a>
                            <ul class="dropdown">
                                <li>
                                    <a asp-controller="Home" asp-action="About">About Us</a>
                                </li>
                                <li>
                                    <a asp-controller="Home" asp-action="Contact">Contacts</a>
                                </li>
                                <li>
                                    <a asp-controller="Cart" asp-action="Index">Shopping Cart</a>
                                </li>
                                <li>
                                    <a asp-controller="Orders" asp-action="Checkout">Check Out</a>
                                </li>
                            </ul>
                        </li>

                        @* ── My Orders: chỉ hiện khi đã đăng nhập (① tái dùng) ── *@
                        @if (User.Identity!.IsAuthenticated)
                        {
                            <li class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Orders"
                                    ? "active" : "")">
                                <a asp-controller="Orders" asp-action="Index">My Orders</a>
                            </li>
                        }

                    </ul>
                </nav>
            </div>

            @* ── Col 3: Search · Wishlist · CartBadge ── *@
            <div class="col-lg-3 col-md-3">
                <div class="header__nav__option">

                    @* Search toggle *@
                    <a href="#" class="search-switch">
                        <img src="~/img/icon/search.png" alt="Search" />
                    </a> 

                    @* Wishlist *@
                    <a href="#">
                        <img src="~/img/icon/heart.png" alt="Wishlist" />
                    </a>

                    @* ⑤ CartBadge View Component
                        Thay thế <a href="#"><img…> <span>0</span></a> + <div class="price">
                       Component tự render số lượng & tổng tiền giỏ hàng *@
                    @await Component.InvokeAsync("CartBadge")

                </div>
            </div>

        </div>

        @* ── Mobile menu toggle ── *@
        <div class="canvas__open"><i class="fa fa-bars"></i></div>
    </div>
    @* ── /MAIN HEADER ── *@

</header>
<!-- Header Section End -->

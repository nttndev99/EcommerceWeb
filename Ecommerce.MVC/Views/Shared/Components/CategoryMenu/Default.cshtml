@using Ecommerce.MVC.Models
@model IEnumerable<CategoryVM>

<style>
/* container */
.mega-parent{
    position:relative;
}

/* mega menu box */
.mega-menu{
    position:absolute;
    left:0;
    top:100%;
    width:900px;
    background:#fff;
    padding:30px 35px;
    border-radius:6px;
    box-shadow:0 12px 30px rgba(0,0,0,0.08);
    display:none;
    z-index:999;
}

/* show */
.mega-parent:hover .mega-menu{
    display:block;
}

/* GRID */
/* grid layout */
.mega-grid{
    display:grid;
    grid-template-columns: repeat(4, 1fr);
    gap:30px;
}

/* column */
.mega-col{
    text-align:left;
}

/* parent title */
.mega-title{
    font-size:16px;
    font-weight:700;      /* đậm */
    text-transform:uppercase; /* chữ hoa */
    margin-bottom:12px;
}

.mega-list a{
    font-size:14px;
    color:#555;
    text-decoration:none;   /* bỏ gạch chân */
    display:block;
    padding:4px 0;
    transition:.2s;
}

.mega-list a:hover{
    color:#e53637;
}
.mega-list{
    list-style:none;
    margin:0;
    padding:0;
}

.mega-list li{
    display:block;
    width:100%;
    margin-bottom:8px;
}

.mega-list a{
    display:block;
}

/* small underline */
.mega-title::after{
    content:"";
    width:30px;
    height:2px;
    background:#e53637;
    position:absolute;
    bottom:-6px;
    left:0;
}

/* list */
.mega-list{
    list-style:none;
    padding:0;
    margin-top:12px;
}

/* item */
.mega-list li{
    margin-bottom:8px;
}

/* child link */
.mega-list a{
    font-size:14px;
    color:#555;
    text-decoration:none;
    transition:.2s;
}

.mega-list a:hover{
    color:#e53637;
    padding-left:5px;
}

/* responsive */
@@media (max-width: 992px){

    .mega-menu{
        width:100%;
        position:static;
        box-shadow:none;
        padding:20px;
    }

    .mega-grid{
        grid-template-columns: repeat(2,1fr);
    }

}
</style>

<li class="mega-parent">
    <a href="#">Categories <i class="arrow_carrot-down"></i></a>

    <div class="mega-menu">
        <div class="mega-grid">

            @foreach (var parent in Model)
            {
                <div class="mega-col">

                    <h6 class="mega-title">
                        <a asp-controller="Home"
                           asp-action="Category"
                           asp-route-slug="@parent.Slug">
                            @parent.Name
                        </a>
                    </h6>

                    @if (parent.Children.Any())
                    {
                        <ul class="mega-list">
                            @foreach (var child in parent.Children)
                            {
                                <li>
                                    <a asp-controller="Home"
                                       asp-action="Category"
                                       asp-route-slug="@child.Slug">
                                        @child.Name
                                    </a>
                                </li>
                            }
                        </ul>
                    }

                </div>
            }

        </div>
    </div>
</li>
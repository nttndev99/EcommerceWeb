@{
    decimal  basePrice = (decimal)ViewBag.BasePrice;
    decimal? salePrice = ViewBag.SalePrice as decimal?;
    string   size      = (ViewBag.Size as string) ?? "md";
    bool     hasSale   = salePrice.HasValue && salePrice.Value < basePrice;
    string   fz        = size switch { "lg" => "fs-3", "sm" => "small", _ => "fs-5" };
    int      disc      = hasSale ? (int)Math.Round((basePrice - salePrice!.Value) / basePrice * 100) : 0;
}
<div class="d-flex align-items-baseline flex-wrap gap-2">
    @if (hasSale)
    {
        <span class="@fz fw-bold text-danger">@salePrice!.Value.ToString("N0") ₫</span>
        <span class="text-muted text-decoration-line-through small">@basePrice.ToString("N0") ₫</span>
        <span class="badge bg-danger rounded-pill" style="font-size:.65rem">-@disc%</span>
    }
    else
    {
        <span class="@fz fw-bold">@basePrice.ToString("N0") ₫</span>
    }
</div>

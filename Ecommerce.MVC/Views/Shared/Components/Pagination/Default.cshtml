@{
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages  = ViewBag.TotalPages ?? 1;

    var route = (ViewBag.RouteValues as Dictionary<string, object> ?? new())
        .ToDictionary(k => k.Key, k => k.Value?.ToString() ?? "");
}

@if (totalPages > 1)
{
    <nav>
        <ul class="pagination pagination-sm mb-0 gap-1">

            @{
                var prev = new Dictionary<string,string>(route);
                prev["pageNumber"] = (currentPage - 1).ToString();
            }

            <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                <a class="page-link rounded" asp-all-route-data="prev">
                    <i class="bi bi-chevron-left"></i>
                </a>
            </li>

            @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
            {
                var r = new Dictionary<string,string>(route);
                r["pageNumber"] = i.ToString();

                <li class="page-item @(i == currentPage ? "active" : "")">
                    <a class="page-link rounded" asp-all-route-data="r">@i</a>
                </li>
            }

            @{
                var next = new Dictionary<string,string>(route);
                next["pageNumber"] = (currentPage + 1).ToString();
            }

            <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                <a class="page-link rounded" asp-all-route-data="next">
                    <i class="bi bi-chevron-right"></i>
                </a>
            </li>

        </ul>
    </nav>
}
}

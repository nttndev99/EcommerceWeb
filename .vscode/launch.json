{
    "version": "0.2.0",
    "configurations": [
        {
        "name": ".NET Launch (ASP.NET Core)",
        "type": "coreclr",
        "request": "launch",
        "preLaunchTask": "build",
        "program": "${workspaceFolder}/Ecommerce.MVC/bin/Debug/net10.0/Ecommerce.MVC.dll",
        "args": [],
        "cwd": "${workspaceFolder}/Ecommerce.MVC",
        "stopAtEntry": false,
        "serverReadyAction": {
            "action": "openExternally",
            "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
        },
        "env": {
            "ASPNETCORE_ENVIRONMENT": "Development"
        }
        }
    ]
}
